<!DOCTYPE html>
<html lang="<%= lang %>"><head><meta charset="utf-8"><title><%= title %></title>
<style>body{font-family:Arial,Helvetica,sans-serif;font-size:12px;color:#111;margin:0;padding:24px}h1{font-size:18px;margin:0 0 4px}table{width:100%;border-collapse:collapse;margin-top:10px}th,td{border:1px solid #999;padding:4px 5px;text-align:center;font-size:11px}th{background:#eee}td.l{text-align:left}.muted{color:#555}.sig{display:flex;justify-content:space-between;margin-top:40px;gap:40px}.sig div{flex:1;border-top:1px solid #111;padding-top:4px;font-size:11px}@media print{.noprint{display:none}}</style></head><body>
<% const L = lang === 'de' ? { title: 'Stundenzettel / Stundennachweis', week: 'Kalenderwoche', site: 'Baustelle', client: 'Auftraggeber', supplier: 'Verleiher', worker: 'Mitarbeiter', prof: 'Tätigkeit', total: 'Summe', from: 'Beginn', to: 'Ende', brk: 'Pause', h: 'Std.', note: 'Bemerkung', signW: 'Unterschrift Verleiher', signC: 'Unterschrift Auftraggeber (Polier / Bauleiter)', date: 'Datum', days: ['Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa', 'So'], legal: 'Aufzeichnung gemäß § 17 MiLoG / § 17c AEntG: Beginn, Ende und Dauer der täglichen Arbeitszeit.', night: 'Nacht' } : { title: 'Hodinový lístok', week: 'Týždeň', site: 'Stavba', client: 'Odberateľ', supplier: 'Dodávateľ', worker: 'Pracovník', prof: 'Profesia', total: 'Spolu', from: 'Od', to: 'Do', brk: 'Prest.', h: 'hod', note: 'Poznámka', signW: 'Podpis dodávateľa', signC: 'Podpis odberateľa (vedúci stavby)', date: 'Dátum', days: U.DAY_NAMES, legal: '', night: 'Noc' }; const detailed = t.rows.some(r => r.s1 || r.s2 || r.s3 || r.s4 || r.s5); %>
<div class="noprint" style="margin-bottom:12px"><button onclick="window.print()">Tlačiť / PDF</button> <a href="/timesheets/<%= t.id %>">← Späť</a></div>
<div style="display:flex;justify-content:space-between"><div><h1><%= L.title %> <%= t.number || '' %></h1><div class="muted"><%= L.week %> <%= wk.week %>/<%= wk.year %> · <%= U.fmtDate(t.week_start) %> – <%= U.fmtDate(U.addDays(t.week_start, 6)) %></div></div><div style="text-align:right"><b><%= settings.company_name %></b><br><span class="muted"><%= settings.company_address %></span></div></div>
<table style="margin-top:12px"><tr><th style="width:50%"><%= L.supplier %></th><th><%= L.client %></th></tr><tr><td class="l"><b><%= settings.company_name %></b>, <%= settings.company_address %><% if (settings.aug_permit_number) { %><br>AÜG-Erlaubnis Nr. <%= settings.aug_permit_number %><% } %></td><td class="l"><b><%= t.client_name %></b><%= t.client_address ? ', ' + t.client_address : '' %><br><%= L.site %>: <b><%= t.site_name %></b><%= t.site_address ? ', ' + t.site_address : '' %></td></tr></table>
<table><tr><th class="l"><%= L.worker %></th><th><%= L.prof %></th><% days.forEach((d, i) => { %><th><%= L.days[i] %><br><%= d.slice(8,10) %>.<%= d.slice(5,7) %>.<% if (detailed) { %><br><span class="muted"><%= L.from %>–<%= L.to %> / <%= L.brk %></span><% } %></th><% }) %><th><%= L.total %><br><%= L.h %></th><th><%= L.night %></th></tr>
<% for (const r of t.rows) { %><tr><td class="l"><b><%= r.last_name %> <%= r.first_name %></b><% if (r.birth_date) { %><br><span class="muted"><%= U.fmtDate(r.birth_date) %></span><% } %></td><td><%= r.profession || r.position || '' %></td><% for (let i = 1; i <= 7; i++) { %><td><% if (detailed && r['s'+i]) { %><span class="muted"><%= r['s'+i] %>–<%= r['e'+i] %><%= r['b'+i] ? ' / ' + r['b'+i] + "'" : '' %></span><br><% } %><b><%= r['d'+i] ? U.hours(r['d'+i]) : '–' %></b></td><% } %><td><b><%= U.hours(r.total) %></b></td><td><%= r.night_hours ? U.hours(r.night_hours) : '' %></td></tr><% } %>
<tr><th class="l" colspan="2"><%= L.total %></th><% for (let i = 1; i <= 7; i++) { %><th><%= U.hours(t.rows.reduce((s, r) => s + (r['d'+i] || 0), 0)) %></th><% } %><th><%= U.hours(t.rows.reduce((s, r) => s + r.total, 0)) %></th><th><%= U.hours(t.rows.reduce((s, r) => s + (r.night_hours || 0), 0)) %></th></tr></table>
<% if (t.note) { %><p><b><%= L.note %>:</b> <%= t.note %></p><% } %>
<% if (L.legal) { %><p class="muted" style="font-size:10px"><%= L.legal %></p><% } %>
<div class="sig"><div><%= L.signW %><br><span class="muted"><%= L.date %>: ____________</span></div><div><% if (signature) { %><img src="/attachments/<%= signature.id %>" style="max-height:60px;display:block;margin-top:-70px"><% } %><%= L.signC %><br><span class="muted"><%= t.signed_by ? t.signed_by + ', ' + (t.signed_at || '').slice(0, 10) : L.date + ': ____________' %></span></div></div>
</body></html>
