<!DOCTYPE html><html lang="<%= lang %>"><head><meta charset="utf-8"><title><%= title %></title>
<style>body{font-family:Arial,sans-serif;font-size:12px;color:#111;padding:28px;max-width:640px;margin:0 auto}h1{font-size:18px;margin:0 0 2px}table{width:100%;border-collapse:collapse;margin-top:12px}td{padding:5px 6px;border-bottom:1px solid #ddd}td.n{text-align:right;white-space:nowrap}tr.t td{font-weight:bold;font-size:14px;border-top:2px solid #111}.muted{color:#666}.sig{display:flex;justify-content:space-between;margin-top:48px;gap:40px}.sig div{flex:1;border-top:1px solid #111;padding-top:4px;font-size:11px}@media print{.noprint{display:none}}</style></head><body>
<% const L = { sk: { t: 'Vyúčtovanie odmeny za mesiac', w: 'Pracovník', hours: 'Odpracované hodiny', wage: 'Odmena', pd: 'Zahraničné stravné (diéty)', days: 'dní', bonus: 'Bonusy / doplatky', adv: 'Vyplatené zálohy', ded: 'Zrážky', tot: 'K výplate', iban: 'Výplata na účet', signW: 'Podpis pracovníka', signC: 'Za firmu', note: 'Poznámka', paid: 'Vyplatené dňa' }, uk: { t: 'Розрахунок винагороди за місяць', w: 'Працівник', hours: 'Відпрацьовані години', wage: 'Винагорода', pd: 'Добові (відрядження)', days: 'днів', bonus: 'Бонуси / доплати', adv: 'Виплачені аванси', ded: 'Утримання', tot: 'До виплати', iban: 'Виплата на рахунок', signW: 'Підпис працівника', signC: 'За фірму', note: 'Примітка', paid: 'Виплачено' }, de: { t: 'Lohnabrechnung für den Monat', w: 'Mitarbeiter', hours: 'Geleistete Stunden', wage: 'Vergütung', pd: 'Auslösung / Verpflegungsmehraufwand', days: 'Tage', bonus: 'Boni / Nachzahlungen', adv: 'Ausgezahlte Vorschüsse', ded: 'Abzüge', tot: 'Auszahlungsbetrag', iban: 'Überweisung auf Konto', signW: 'Unterschrift Mitarbeiter', signC: 'Für die Firma', note: 'Bemerkung', paid: 'Ausgezahlt am' } }[lang] || null; const T = L || {}; %>
<div class="noprint"><button onclick="window.print()">Tlačiť</button> <a href="?lang=sk">SK</a> · <a href="?lang=uk">UA</a> · <a href="?lang=de">DE</a> · <a href="/settlements/<%= s.id %>">← Späť</a></div>
<h1><%= T.t %> <%= s.month %></h1><div class="muted"><%= settings.company_name %>, <%= settings.company_address %></div>
<p><b><%= T.w %>:</b> <%= s.last_name %> <%= s.first_name %><%= s.position ? ' · ' + s.position : '' %></p>
<table>
<tr><td><%= T.hours %></td><td class="n"><%= U.hours(s.hours) %> h × <%= U.money(s.wage_rate) %></td><td class="n"><%= U.money(s.wage_total) %></td></tr>
<% if (s.per_diem_total) { %><tr><td><%= T.pd %></td><td class="n"><%= s.per_diem_days %> <%= T.days %> × <%= U.money(s.per_diem_rate) %></td><td class="n"><%= U.money(s.per_diem_total) %></td></tr><% } %>
<% const b = s.transactions.filter(t => t.type === 'bonus'); if (b.length) { for (const t of b) { %><tr><td><%= T.bonus %>: <%= t.description || '' %></td><td class="n"><%= U.fmtDate(t.date) %></td><td class="n"><%= U.money(t.amount) %></td></tr><% } } %>
<% for (const t of s.transactions.filter(t => t.type === 'advance')) { %><tr><td><%= T.adv %>: <%= t.description || '' %></td><td class="n"><%= U.fmtDate(t.date) %></td><td class="n">− <%= U.money(t.amount) %></td></tr><% } %>
<% for (const t of s.transactions.filter(t => t.type === 'deduction')) { %><tr><td><%= T.ded %>: <%= t.description || '' %></td><td class="n"><%= U.fmtDate(t.date) %></td><td class="n">− <%= U.money(t.amount) %></td></tr><% } %>
<tr class="t"><td colspan="2"><%= T.tot %></td><td class="n"><%= U.money(s.total_due) %></td></tr></table>
<% if (s.iban) { %><p class="muted"><%= T.iban %>: <%= s.iban %></p><% } %><% if (s.paid_at) { %><p><%= T.paid %>: <%= U.fmtDate(s.paid_at) %></p><% } %><% if (s.note) { %><p><%= T.note %>: <%= s.note %></p><% } %>
<div class="sig"><div><%= T.signW %></div><div><%= T.signC %></div></div>
</body></html>
