<%- include('../partials/header') %>
<h1><%= title %></h1>
<form method="post" action="/expenses/save" class="card" style="max-width:760px">
  <input type="hidden" name="id" value="<%= e.id || '' %>">
  <div class="row"><div class="field"><label>Dátum *</label><input type="date" name="date" value="<%= e.date %>" required></div><div class="field"><label>Kategória *</label><select name="category" required><% for (const c of categories) { %><option <%= e.category===c?'selected':'' %>><%= c %></option><% } %></select></div></div>
  <div class="row"><div class="field" style="flex:2"><label>Popis</label><input type="text" name="description" value="<%= e.description || '' %>" placeholder="napr. Ubytovanie – ubytovňa Petržalka, marec"></div><div class="field"><label>Dodávateľ</label><input type="text" name="supplier" value="<%= e.supplier || '' %>"></div></div>
  <div class="row">
    <div class="field"><label>Suma bez DPH *</label><input type="number" step="0.01" name="amount_net" id="net" value="<%= e.amount_net ?? '' %>" required oninput="calcTotal()"></div>
    <div class="field"><label>Sadzba DPH %</label><input type="number" step="0.01" name="vat_rate" id="vat" value="<%= e.vat_rate ?? 23 %>" oninput="calcTotal()"></div>
    <div class="field"><label>Suma s DPH</label><input type="number" step="0.01" name="amount_total" id="total" value="<%= e.amount_total ?? '' %>" oninput="calcNet()"></div>
  </div>
  <div class="row">
    <div class="field"><label>Pracovník (voliteľné)</label><select name="worker_id"><option value="">–</option><% for (const w of workers) { %><option value="<%= w.id %>" <%= e.worker_id==w.id?'selected':'' %>><%= w.last_name %> <%= w.first_name %></option><% } %></select></div>
    <div class="field"><label>Stavba (voliteľné)</label><select name="site_id"><option value="">–</option><% for (const s of sites) { %><option value="<%= s.id %>" <%= e.site_id==s.id?'selected':'' %>><%= s.client_name %> – <%= s.name %></option><% } %></select></div>
  </div>
  <div class="field"><label>Poznámka</label><textarea name="note"><%= e.note || '' %></textarea></div>
  <div class="row"><label class="check"><input type="checkbox" name="recurring" <%= e.recurring ? 'checked' : '' %>> Opakuje sa každý mesiac (nájom, lízing, poistenie…)</label><label class="check"><input type="checkbox" name="paid" <%= e.paid ? 'checked' : '' %>> Uhradené</label></div>
  <div class="actions mt"><button class="btn" type="submit">Uložiť</button><a href="/expenses" class="btn secondary">Zrušiť</a></div>
</form>
<script>
function calcTotal(){const n=parseFloat(net.value)||0,v=parseFloat(vat.value)||0;total.value=(n*(1+v/100)).toFixed(2);}
function calcNet(){const t=parseFloat(total.value)||0,v=parseFloat(vat.value)||0;net.value=(t/(1+v/100)).toFixed(2);}
</script>
<%- include('../partials/footer') %>
