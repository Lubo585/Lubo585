<%- include('../partials/header') %>
<div class="topbar"><h1>Hodinové lístky</h1></div>
<div class="card">
  <form method="post" action="/timesheets/new" class="row" style="align-items:flex-end">
    <div class="field" style="flex:2"><label>Stavba</label><select name="site_id" required><option value="">– vyberte stavbu –</option><% for (const s of sites) { %><option value="<%= s.id %>"><%= s.client_name %> – <%= s.name %></option><% } %></select></div>
    <div class="field"><label>Týždeň (ľubovoľný deň v týždni)</label><input type="date" name="week" value="<%= thisWeek %>"></div>
    <div class="field" style="flex:0"><button class="btn" type="submit">Otvoriť / vytvoriť lístok</button></div>
  </form>
  <% if (!sites.length) { %><p class="muted">Najprv pridajte <a href="/clients">klienta a stavbu</a>.</p><% } %>
</div>
<div class="card">
  <form method="get" class="row" style="align-items:flex-end;margin-bottom:12px">
    <div class="field"><label>Týždeň</label><input type="date" name="week" value="<%= week || '' %>"></div>
    <div class="field"><label>Stav</label><select name="status"><option value="">všetky</option><option value="draft" <%= status==='draft'?'selected':'' %>>rozpracované</option><option value="approved" <%= status==='approved'?'selected':'' %>>schválené</option><option value="invoiced" <%= status==='invoiced'?'selected':'' %>>vyfakturované</option></select></div>
    <div class="field" style="flex:0"><button class="btn secondary" type="submit">Filtrovať</button> <a href="/timesheets" class="btn secondary">Zrušiť</a></div>
  </form>
  <% if (!sheets.length) { %><p class="muted">Žiadne hodinové lístky.</p><% } else { %>
  <table><tr><th>Týždeň</th><th>Klient</th><th>Stavba</th><th class="num">Pracovníci</th><th class="num">Hodiny</th><th>Stav</th><th></th></tr>
  <% for (const t of sheets) { const wk = U.isoWeek(t.week_start); const st = STATUS[t.status]; %>
  <tr><td><a href="/timesheets/<%= t.id %>">T<%= wk.week %>/<%= wk.year %></a> <span class="muted small"><%= U.fmtDate(t.week_start) %> – <%= U.fmtDate(U.addDays(t.week_start, 6)) %></span></td><td><%= t.client_name %></td><td><%= t.site_name %></td><td class="num"><%= t.workers %></td><td class="num"><%= U.hours(t.hours) %></td><td><span class="badge <%= st[0] %>"><%= st[1] %></span><% if (t.signed_at) { %> <span class="badge ok" title="podpísaný">✓</span><% } %></td>
  <td class="right nowrap"><a href="/timesheets/<%= t.id %>" class="btn sm secondary">Otvoriť</a> <% if (t.status !== 'invoiced') { %><form class="inline" method="post" action="/timesheets/<%= t.id %>/delete" onsubmit="return confirm('Odstrániť hodinový lístok?')"><button class="btn sm danger">×</button></form><% } %></td></tr>
  <% } %></table><% } %>
</div>
<%- include('../partials/footer') %>
