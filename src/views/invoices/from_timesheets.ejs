<%- include('../partials/header') %>
<h1>Fakturovať odpracované hodiny</h1>
<div class="grid grid-2">
  <form method="post" action="/invoices/from-timesheets" class="card">
    <h2>Nová faktúra z hodinových lístkov</h2>
    <div class="field"><label>Klient *</label><select name="client_id" id="client_id" required onchange="filterSites()"><option value="">– vyberte –</option><% for (const c of clients) { %><option value="<%= c.id %>" <%= client_id==c.id?'selected':'' %>><%= c.name %></option><% } %></select></div>
    <div class="field"><label>Stavba (voliteľné – inak všetky stavby klienta)</label><select name="site_id" id="site_id"><option value="">všetky stavby</option><% for (const s of sites) { %><option value="<%= s.id %>" data-client="<%= s.client_id %>" <%= site_id==s.id?'selected':'' %>><%= s.name %></option><% } %></select></div>
    <div class="row"><div class="field"><label>Obdobie od (týždeň začínajúci)</label><input type="date" name="from" value="<%= from %>" required></div><div class="field"><label>do</label><input type="date" name="to" value="<%= to %>" required></div></div>
    <div class="row"><div class="field"><label>Dátum vystavenia</label><input type="date" name="issue_date" value="<%= today %>"></div><div class="field"><label>Sadzba DPH % (iba SK klient)</label><input type="number" step="0.01" name="vat_rate" value="<%= settings.default_vat_rate %>"></div><div class="field"><label>Jazyk faktúry</label><select name="language"><option value="">podľa klienta</option><option value="de">nemčina</option><option value="sk">slovenčina</option></select></div></div>
    <p class="help">Režim DPH, zádržné, skonto, splatnosť a prípadná Bauabzugsteuer sa doplnia podľa nastavenia klienta. Ak má klient cenník, príplatky za nadčas, sobotu, nedeľu a nočnú prácu sa vyčíslia ako samostatné položky.</p>
    <div class="field"><label>Poznámka na faktúre</label><input type="text" name="note"></div>
    <p class="help">Faktúra sa vytvorí zo <b>schválených</b> a doteraz nevyfakturovaných lístkov, ktorých týždeň začína v zadanom období. Položky sa zoskupia podľa pracovníka a stavby. Splatnosť, zádržné a skonto sa doplnia podľa nastavenia klienta.</p>
    <button class="btn" type="submit">Vystaviť faktúru</button>
  </form>
  <div class="card">
    <h2>Čaká na fakturáciu</h2>
    <% if (!pending.length) { %><p class="muted">Žiadne schválené nevyfakturované hodiny. Hodiny sa fakturujú až po schválení hodinového lístka.</p><% } else { %>
    <table class="compact"><tr><th>Klient / stavba</th><th>Týždne</th><th class="num">Lístky</th><th class="num">Hodiny</th><th></th></tr>
    <% for (const p of pending) { %><tr><td><b><%= p.client_name %></b><br><span class="small muted"><%= p.site_name %></span></td><td class="small"><%= U.fmtDate(p.first_week) %> – <%= U.fmtDate(U.addDays(p.last_week, 6)) %></td><td class="num"><%= p.sheets %></td><td class="num"><%= U.hours(p.hours) %></td><td><button class="btn sm secondary" type="button" onclick="pick(<%= p.client_id %>, <%= p.site_id %>, '<%= p.first_week %>', '<%= p.last_week %>')">Vybrať</button></td></tr><% } %></table><% } %>
  </div>
</div>
<script>
function filterSites(){const c=client_id.value;[...site_id.options].forEach(o=>{if(!o.value)return;o.hidden=c&&o.dataset.client!==c;});if(site_id.selectedOptions[0]&&site_id.selectedOptions[0].hidden)site_id.value='';}
function pick(c,s,f,t){client_id.value=c;filterSites();site_id.value=s;document.querySelector('[name=from]').value=f;document.querySelector('[name=to]').value=t;window.scrollTo(0,0);}
filterSites();
</script>
<%- include('../partials/footer') %>
