<%- include('../partials/header') %>
<h1><%= title %></h1>
<form method="post" action="/clients/save" class="card" style="max-width:900px">
  <input type="hidden" name="id" value="<%= c.id || '' %>">
  <div class="row"><div class="field" style="flex:3"><label>Názov firmy *</label><input type="text" name="name" value="<%= c.name || '' %>" required></div><div class="field"><label>Krajina (kód)</label><input type="text" name="country" value="<%= c.country || 'DE' %>" maxlength="2" placeholder="DE"></div><div class="field"><label>Jazyk dokladov</label><select name="language"><option value="de" <%= c.language==='de'?'selected':'' %>>nemčina</option><option value="sk" <%= c.language==='sk'?'selected':'' %>>slovenčina</option></select></div></div>
  <div class="row"><div class="field"><label>IČO / HRB</label><input type="text" name="ico" value="<%= c.ico || '' %>" placeholder="HRB 12345"></div><div class="field"><label>DIČ / Steuernummer</label><input type="text" name="dic" value="<%= c.dic || '' %>"></div><div class="field"><label>IČ DPH / USt-IdNr. *</label><input type="text" name="ic_dph" value="<%= c.ic_dph || '' %>" placeholder="DE123456789"><div class="help">Pri prenesení DPH v EÚ povinné na faktúre aj v súhrnnom výkaze.</div></div></div>
  <div class="row"><div class="field" style="flex:2"><label>Adresa (sídlo)</label><input type="text" name="address" value="<%= c.address || '' %>" placeholder="Musterstraße 1, 80331 München"></div><div class="field"><label>Zápis v registri (Handelsregister)</label><input type="text" name="register" value="<%= c.register || '' %>" placeholder="Amtsgericht München, HRB 12345"></div></div>
  <div class="row"><div class="field"><label>Kontaktná osoba</label><input type="text" name="contact_person" value="<%= c.contact_person || '' %>"></div><div class="field"><label>E-mail (upomienky)</label><input type="email" name="email" value="<%= c.email || '' %>"></div><div class="field"><label>E-mail pre faktúry</label><input type="email" name="invoice_email" value="<%= c.invoice_email || '' %>" placeholder="rechnungen@firma.de"></div><div class="field"><label>Telefón</label><input type="text" name="phone" value="<%= c.phone || '' %>"></div></div>
  <h2 class="mt">DPH a nemecké odvody</h2>
  <div class="field"><label>Režim DPH</label><select name="vat_mode"><% for (const [k, v] of Object.entries(VAT_MODES)) { %><option value="<%= k %>" <%= (c.vat_mode||'standard')===k?'selected':'' %>><%= v %></option><% } %></select><div class="help">Pre nemeckého klienta: „Prenesenie DPH v EÚ“ – faktúra bez DPH, s oboma IČ DPH a textom „Steuerschuldnerschaft des Leistungsempfängers“; faktúra vstupuje do súhrnného výkazu.</div></div>
  <div class="row"><div class="field"><label class="check"><input type="checkbox" name="soka_bau" <%= c.soka_bau ? 'checked' : '' %>> SOKA-BAU (stavebné práce – povinnosť Urlaubskasse)</label></div><div class="field"><label class="check"><input type="checkbox" name="bauabzugsteuer" <%= c.bauabzugsteuer ? 'checked' : '' %>> Klient zráža 15 % Bauabzugsteuer (§ 48 EStG), ak nemáme platnú Freistellungsbescheinigung</label></div></div>
  <div class="row"><div class="field"><label>Číslo zákazníka u klienta / Kreditorennummer</label><input type="text" name="aug_customer_number" value="<%= c.aug_customer_number || '' %>"></div><div class="field" style="flex:2"><label>Text o platbe na faktúre (voliteľné)</label><input type="text" name="payment_note" value="<%= c.payment_note || '' %>" placeholder="napr. Bitte Rechnungsnummer als Verwendungszweck angeben"></div></div>
  <h2 class="mt">Platobné podmienky</h2>
  <div class="row">
    <div class="field"><label>Splatnosť faktúr (dní)</label><input type="number" name="due_days" value="<%= c.due_days ?? 14 %>"></div>
    <div class="field"><label>Zádržné % (Sicherheitseinbehalt)</label><input type="number" step="0.01" name="retention_percent" value="<%= c.retention_percent ?? 0 %>"></div>
    <div class="field"><label>Zádržné splatné po (mesiacov)</label><input type="number" name="retention_months" value="<%= c.retention_months ?? 0 %>"></div>
    <div class="field"><label>Skonto %</label><input type="number" step="0.01" name="skonto_percent" value="<%= c.skonto_percent ?? 0 %>"></div>
    <div class="field"><label>Skonto do (dní)</label><input type="number" name="skonto_days" value="<%= c.skonto_days ?? 0 %>"></div>
  </div>
  <div class="field"><label>Poznámka</label><textarea name="note"><%= c.note || '' %></textarea></div>
  <div class="field"><label class="check"><input type="checkbox" name="active" <%= c.active ? 'checked' : '' %>> Aktívny</label></div>
  <div class="actions"><button class="btn" type="submit">Uložiť</button><a href="<%= c.id ? '/clients/' + c.id : '/clients' %>" class="btn secondary">Zrušiť</a></div>
</form>
<%- include('../partials/footer') %>
