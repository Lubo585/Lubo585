<%- include('../partials/header') %>
<h1><%= title %></h1>
<form method="post" action="/quotes/save" class="card"><input type="hidden" name="id" value="<%= q.id || '' %>">
  <div class="row"><div class="field"><label>Číslo</label><input type="text" name="number" value="<%= q.number %>" required></div><div class="field" style="flex:2"><label>Klient *</label><select name="client_id" id="client_id" required onchange="[...site_id.options].forEach(o=>{if(o.value)o.hidden=this.value&&o.dataset.client!==this.value;});const o=this.selectedOptions[0];if(o&&o.dataset.lang)language.value=o.dataset.lang;"><option value="">– vyberte –</option><% for (const c of clients) { %><option value="<%= c.id %>" data-lang="<%= c.language || 'sk' %>" <%= q.client_id==c.id?'selected':'' %>><%= c.name %></option><% } %></select></div><div class="field"><label>Zákazka</label><select name="site_id" id="site_id"><option value="">–</option><% for (const s of sites) { %><option value="<%= s.id %>" data-client="<%= s.client_id %>" <%= q.site_id==s.id?'selected':'' %>><%= s.name %></option><% } %></select></div></div>
  <div class="row"><div class="field"><label>Dátum</label><input type="date" name="date" value="<%= q.date %>" required></div><div class="field"><label>Platnosť do</label><input type="date" name="valid_until" value="<%= q.valid_until || '' %>"></div><div class="field"><label>Jazyk</label><select name="language" id="language"><option value="de" <%= q.language==='de'?'selected':'' %>>nemčina</option><option value="sk" <%= q.language==='sk'?'selected':'' %>>slovenčina</option></select></div></div>
  <h2 class="mt">Položky (sadzby za hodinu podľa profesie)</h2>
  <table class="compact" id="items"><tr><th style="width:50%">Popis</th><th class="num">Množstvo</th><th>MJ</th><th class="num">Cena</th><th></th></tr>
  <% q.items.forEach((it, i) => { %><tr><td><input type="text" name="items[<%= i %>][description]" value="<%= it.description || '' %>"></td><td><input type="number" step="0.01" name="items[<%= i %>][quantity]" value="<%= it.quantity ?? 1 %>"></td><td><input type="text" name="items[<%= i %>][unit]" value="<%= it.unit || 'hod' %>"></td><td><input type="number" step="0.01" name="items[<%= i %>][unit_price]" value="<%= it.unit_price ?? '' %>"></td><td><button type="button" class="btn sm danger" onclick="this.closest('tr').remove()">×</button></td></tr><% }) %></table>
  <button type="button" class="btn sm secondary mt" onclick="addItem()">+ Položka</button>
  <div class="field mt"><label>Poznámka / podmienky</label><textarea name="note"><%= q.note || '' %></textarea></div>
  <div class="actions"><button class="btn">Uložiť ponuku</button><a href="/quotes" class="btn secondary">Zrušiť</a></div>
</form>
<script>let n=<%= q.items.length %>;function addItem(){const tr=document.createElement('tr');tr.innerHTML=`<td><input type="text" name="items[${n}][description]"></td><td><input type="number" step="0.01" name="items[${n}][quantity]" value="1"></td><td><input type="text" name="items[${n}][unit]" value="hod"></td><td><input type="number" step="0.01" name="items[${n}][unit_price]"></td><td><button type="button" class="btn sm danger" onclick="this.closest('tr').remove()">×</button></td>`;items.appendChild(tr);n++;}client_id.dispatchEvent(new Event('change'));</script>
<%- include('../partials/footer') %>
