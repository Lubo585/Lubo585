<%- include('../partials/header') %>
<h1>Nové vyúčtovanie</h1>
<form method="get" class="card row" style="align-items:flex-end;max-width:700px"><div class="field"><label>Mesiac</label><input type="month" name="month" value="<%= month %>"></div><div class="field" style="flex:2"><label>Pracovník</label><select name="worker_id" onchange="this.form.submit()"><option value="">– vyberte –</option><% for (const w of workers) { %><option value="<%= w.id %>" <%= worker_id==w.id?'selected':'' %>><%= w.last_name %> <%= w.first_name %></option><% } %></select></div><div class="field" style="flex:0"><button class="btn secondary">Náhľad</button></div></form>
<% if (preview) { %>
<form method="post" action="/settlements/create" class="card" style="max-width:700px"><input type="hidden" name="month" value="<%= month %>"><input type="hidden" name="worker_id" value="<%= worker_id %>">
  <h2><%= preview.worker.last_name %> <%= preview.worker.first_name %> – <%= month %></h2>
  <p><b><%= U.hours(preview.hours) %> h</b> odpracovaných za <%= preview.days %> dní (z toho <%= preview.deDays %> dní v DE), nadčasy a víkendy <%= U.hours(preview.overtime) %> h.</p>
  <div class="row"><div class="field"><label>Mzda € / hod</label><input type="number" step="0.01" name="wage_rate" value="<%= preview.worker.wage_rate ?? '' %>" required></div><div class="field"><label>Diéty – dní</label><input type="number" name="per_diem_days" value="<%= preview.worker.per_diem ? preview.deDays : 0 %>"></div><div class="field"><label>Diéty € / deň</label><input type="number" step="0.01" name="per_diem_rate" value="<%= preview.worker.per_diem ? perDiemDefault : 0 %>"></div></div>
  <% if (preview.transactions.length) { %><h3>Nevyúčtované zálohy / zrážky / bonusy (zahrnú sa)</h3><table class="compact"><% for (const t of preview.transactions) { %><tr><td><%= U.fmtDate(t.date) %></td><td><%= { advance: 'záloha', deduction: 'zrážka', bonus: 'bonus' }[t.type] %> <%= t.description || '' %></td><td class="num"><%= U.money(t.amount) %></td></tr><% } %></table><% } %>
  <details><summary>Dni s hodinami</summary><table class="compact mt"><% for (const d of preview.detail) { %><tr><td><%= U.fmtDate(d.day) %></td><td><%= d.site %></td><td class="num"><%= U.hours(d.hours) %> h</td></tr><% } %></table></details>
  <div class="field mt"><label>Poznámka</label><input type="text" name="note"></div>
  <button class="btn">Vytvoriť vyúčtovanie</button></form>
<% } %>
<%- include('../partials/footer') %>
