<%- include('../partials/header') %>
<div class="topbar"><h1>Pracovníci</h1><div class="actions"><a href="/compliance" class="btn secondary">Compliance DE</a><a href="/workers?all=<%= showAll ? '0' : '1' %>" class="btn secondary"><%= showAll ? 'Iba aktívni' : 'Aj neaktívni' %></a><a href="/workers/new" class="btn">+ Nový pracovník</a></div></div>
<div class="card">
<% if (!workers.length) { %><p class="muted">Zatiaľ žiadni pracovníci.</p><% } else { %>
<table><tr><th>Meno</th><th>Profesia</th><th>Národnosť</th><th>Nasadenie teraz</th><th>A1 do</th><th>Doklady</th><th class="num">Náklad €/h</th><th class="num">Mzda €/h</th><th class="num">Hodiny tento mesiac</th><th></th></tr>
<% for (const w of workers) { const a1d = w.a1_until ? U.diffDays(w.a1_until, U.today()) : null; %>
<tr><td><a href="/workers/<%= w.id %>"><b><%= w.last_name %> <%= w.first_name %></b></a> <% if (!w.active) { %><span class="badge muted">neaktívny</span><% } %><br><span class="small muted"><%= w.phone || '' %></span></td><td><%= w.position %><%= w.lohngruppe ? ' · ' + w.lohngruppe : '' %></td><td><%= w.nationality %> <% if (w.eu_citizen) { %><span class="badge muted">EÚ</span><% } %></td><td class="small"><% if (w.current_site) { %><%= w.current_site %><% } else { %><span class="muted">–</span><% } %></td>
<td><% if (!w.a1_until) { %><span class="badge danger">chýba</span><% } else if (a1d < 0) { %><span class="badge danger">expir. <%= U.fmtDate(w.a1_until) %></span><% } else if (a1d < 60) { %><span class="badge warn"><%= U.fmtDate(w.a1_until) %></span><% } else { %><span class="badge ok"><%= U.fmtDate(w.a1_until) %></span><% } %></td>
<td><% if (w.expired_docs) { %><span class="badge danger"><%= w.expired_docs %> expir.</span><% } else if (w.next_expiry && U.diffDays(w.next_expiry, U.today()) < 60) { %><span class="badge warn">do <%= U.fmtDate(w.next_expiry) %></span><% } else { %><span class="badge ok">OK</span><% } %></td>
<td class="num"><%= U.money(w.hourly_cost) %></td><td class="num"><%= w.wage_rate ? U.money(w.wage_rate) : '–' %></td><td class="num"><%= U.hours(w.hours_month) %></td>
<td class="right nowrap"><a href="/workers/<%= w.id %>" class="btn sm secondary">Detail</a> <a href="/workers/<%= w.id %>/edit" class="btn sm secondary">Upraviť</a></td></tr>
<% } %></table><% } %>
</div>
<%- include('../partials/footer') %>
