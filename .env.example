# ---- AI agent (Claude) ----
# Kľúč získaš na https://platform.claude.com -> API keys
ANTHROPIC_API_KEY=sk-ant-...
# Model pre analýzu (predvolene Claude Opus 5.5)
AI_MODEL=claude-opus-5-5
# Hĺbka uvažovania modelu: low | medium | high | xhigh | max
AI_EFFORT=high

# ---- Trhové dáta ----
# auto = skúsi Binance Futures, pri geo-blokácii prepne na OKX perpetual swap
# binance | okx | auto
MARKET_PROVIDER=auto

# ---- TradingView webhook ----
# Tajný reťazec, ktorý musí byť v každom alerte z TradingView (pole "secret")
TV_WEBHOOK_SECRET=zmen-ma

# ---- Voliteľné: Telegram notifikácie ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Monitor kanálov ----
# Ako často (v sekundách) kontrolovať, či sa cena blíži k hranici kanála. 0 = vypnuté
MONITOR_INTERVAL_SECONDS=60
# Vzdialenosť od hranice kanála (v % ceny), pri ktorej vznikne upozornenie
MONITOR_PROXIMITY_PCT=0.4

# ---- Automatická analýza ----
# true = po každom alerte z TradingView AI agent sám spustí analýzu symbolu a pošle zhrnutie na Telegram
AUTO_ANALYZE_ON_TV_ALERT=false
AUTO_ANALYZE_TIMEFRAMES=1d,4h,1h

# ---- Aplikácia ----
DB_PATH=data/agent.db
DEFAULT_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
HOST=127.0.0.1
PORT=8000
