<%- include('../partials/header') %>
<div class="topbar"><h1><%= c.name %></h1><div class="actions"><a href="/invoices/from-timesheets?client_id=<%= c.id %>" class="btn secondary">Fakturovať hodiny</a><a href="/clients/<%= c.id %>/edit" class="btn">Upraviť klienta</a></div></div>
<div class="grid grid-2">
  <div class="card">
    <h2>Údaje</h2>
    <table class="compact"><tr><td class="muted">IČO / DIČ / IČ DPH</td><td><%= c.ico || '–' %> / <%= c.dic || '–' %> / <%= c.ic_dph || '–' %></td></tr><tr><td class="muted">Adresa</td><td><%= c.address || '–' %></td></tr><tr><td class="muted">Kontakt</td><td><%= c.contact_person || '' %> <%= c.email || '' %> <%= c.phone || '' %></td></tr>
    <tr><td class="muted">Splatnosť</td><td><%= c.due_days %> dní</td></tr><tr><td class="muted">Zádržné</td><td><%= c.retention_percent ? c.retention_percent + ' %, splatné po ' + c.retention_months + ' mesiacoch' : 'nie' %></td></tr><tr><td class="muted">Skonto</td><td><%= c.skonto_percent ? c.skonto_percent + ' % pri úhrade do ' + c.skonto_days + ' dní' : 'nie' %></td></tr><tr><td class="muted">DPH</td><td><%= VAT_MODES[c.vat_mode] || 'štandardne' %></td></tr><tr><td class="muted">Krajina / jazyk</td><td><%= c.country || 'SK' %> / <%= c.language === 'de' ? 'nemčina' : 'slovenčina' %><%= c.soka_bau ? ' · <span class="badge warn">SOKA-BAU</span>' : '' %><%= c.bauabzugsteuer ? ' · <span class="badge warn">Bauabzugsteuer 15 %</span>' : '' %></td></tr><% if (c.register) { %><tr><td class="muted">Register</td><td><%= c.register %></td></tr><% } %></table>
    <% if (c.note) { %><p class="small muted"><%= c.note %></p><% } %>
  </div>
  <div class="card">
    <h2>Zákazky / stavby</h2>
    <% if (!sites.length) { %><p class="muted">Zatiaľ žiadne zákazky.</p><% } else { %>
    <table class="compact"><tr><th>Názov</th><th>Stav</th><th class="num">Sadzba €/h</th><th></th></tr>
    <% const OS = { open: ['Voľná','info'], active: ['Rozpracovaná','warn'], finished: ['Ukončená','muted'] }; for (const s of sites) { const st = OS[s.status] || OS.open; %>
    <tr><td><a href="/orders/<%= s.id %>"><%= s.name %></a><br><span class="small muted"><%= s.address || '' %></span></td><td><span class="badge <%= st[1] %>"><%= st[0] %></span></td><td class="num"><%= U.money(s.hourly_rate) %></td><td class="right"><a href="/orders/<%= s.id %>/edit" class="btn sm secondary">Upraviť</a></td></tr>
    <% } %></table><% } %>
    <a href="/orders/new?client_id=<%= c.id %>" class="btn sm mt">+ Nová zákazka</a>
  </div>
</div>
<div class="grid grid-2">
  <div class="card" id="rates"><h2>Cenník (sadzby podľa profesie a príplatky)</h2>
    <p class="help">Ak je cenník vyplnený, fakturácia z hodinových lístkov použije sadzbu podľa profesie pracovníka a vyčísli príplatky za nadčas, sobotu, nedeľu/sviatok a nočnú prácu ako samostatné položky. Bez cenníka sa použije sadzba zákazky bez príplatkov.</p>
    <% if (rates.length) { %><table class="compact"><tr><th>Profesia</th><th class="num">€/h</th><th class="num">Nadčas</th><th class="num">So</th><th class="num">Ne/sviatok</th><th class="num">Noc</th><th></th></tr><% for (const r of rates) { %><tr><td><b><%= r.profession %></b><%= r.note ? '<br><span class="small muted">' + r.note + '</span>' : '' %></td><td class="num"><%= U.money(r.rate) %></td><td class="num">+<%= r.overtime_pct %> %</td><td class="num">+<%= r.saturday_pct %> %</td><td class="num">+<%= r.sunday_pct %> %</td><td class="num">+<%= r.night_pct %> %</td><td class="right nowrap"><button type="button" class="btn sm secondary" onclick='editRate(<%- JSON.stringify(r).replace(/</g, "\\u003c") %>)'>Upraviť</button> <form class="inline" method="post" action="/clients/<%= c.id %>/rates/<%= r.id %>/delete"><button class="btn sm danger">×</button></form></td></tr><% } %></table><% } %>
    <details class="mt" id="rate-form"><summary>+ Pridať sadzbu</summary><form method="post" action="/clients/<%= c.id %>/rates/save" class="mt"><input type="hidden" name="rate_id" id="rate_id">
      <div class="row"><div class="field" style="flex:2"><label>Profesia (ako u pracovníka)</label><input type="text" name="profession" id="r_prof" required placeholder="murár"></div><div class="field"><label>Sadzba €/h</label><input type="number" step="0.01" name="rate" id="r_rate" required></div></div>
      <div class="row"><div class="field"><label>Nadčas %</label><input type="number" step="0.01" name="overtime_pct" id="r_ot" value="25"></div><div class="field"><label>Sobota %</label><input type="number" step="0.01" name="saturday_pct" id="r_sa" value="25"></div><div class="field"><label>Nedeľa/sviatok %</label><input type="number" step="0.01" name="sunday_pct" id="r_su" value="50"></div><div class="field"><label>Noc %</label><input type="number" step="0.01" name="night_pct" id="r_ni" value="25"></div><div class="field"><label>Platné od</label><input type="date" name="valid_from" id="r_from"></div></div>
      <div class="field"><label>Poznámka</label><input type="text" name="note" id="r_note"></div><button class="btn sm">Uložiť sadzbu</button></form></details>
  </div>
  <div class="card" id="contracts"><h2>Zmluvy</h2>
    <p class="help">AÜG vyžaduje písomnú zmluvu o prenechaní zamestnancov pred začiatkom nasadenia. Dokumenty priložte nižšie.</p>
    <% if (contracts.length) { %><table class="compact"><% for (const k of contracts) { const exp = k.valid_to && k.valid_to < U.today(); %><tr><td><b><%= (CONTRACT_TYPES[k.type] || k.type).split(' (')[0] %></b> <%= k.number || '' %><%= k.note ? '<br><span class="small muted">' + k.note + '</span>' : '' %></td><td class="small nowrap"><%= k.valid_from ? U.fmtDate(k.valid_from) : '?' %> – <%= k.valid_to ? U.fmtDate(k.valid_to) : 'neurčito' %> <%= exp ? '<span class="badge danger">skončená</span>' : '' %></td><td class="right nowrap"><button type="button" class="btn sm secondary" onclick='editContract(<%- JSON.stringify(k).replace(/</g, "\\u003c") %>)'>Upraviť</button> <form class="inline" method="post" action="/clients/<%= c.id %>/contracts/<%= k.id %>/delete"><button class="btn sm danger">×</button></form></td></tr><% } %></table><% } %>
    <details class="mt" id="contract-form"><summary>+ Pridať zmluvu</summary><form method="post" action="/clients/<%= c.id %>/contracts/save" class="mt"><input type="hidden" name="contract_id" id="k_id">
      <div class="row"><div class="field" style="flex:2"><label>Typ</label><select name="type" id="k_type"><% for (const [k, v] of Object.entries(CONTRACT_TYPES)) { %><option value="<%= k %>"><%= v %></option><% } %></select></div><div class="field"><label>Číslo</label><input type="text" name="number" id="k_number"></div></div>
      <div class="row"><div class="field"><label>Podpísaná</label><input type="date" name="signed_at" id="k_signed"></div><div class="field"><label>Platná od</label><input type="date" name="valid_from" id="k_from"></div><div class="field"><label>Platná do</label><input type="date" name="valid_to" id="k_to"></div></div>
      <div class="field"><label>Poznámka</label><input type="text" name="note" id="k_note"></div><button class="btn sm">Uložiť zmluvu</button></form></details>
    <div class="mt"><%- include('../partials/attachments', { entityType: 'client', entityId: c.id, back: '/clients/' + c.id + '#contracts' }) %></div>
  </div>
</div>
<script>
function editRate(r){const f=document.getElementById('rate-form');f.open=true;rate_id.value=r.id;r_prof.value=r.profession;r_rate.value=r.rate;r_ot.value=r.overtime_pct;r_sa.value=r.saturday_pct;r_su.value=r.sunday_pct;r_ni.value=r.night_pct;r_from.value=r.valid_from||'';r_note.value=r.note||'';}
function editContract(k){const f=document.getElementById('contract-form');f.open=true;k_id.value=k.id;k_type.value=k.type;k_number.value=k.number||'';k_signed.value=k.signed_at||'';k_from.value=k.valid_from||'';k_to.value=k.valid_to||'';k_note.value=k.note||'';}
</script>
<% if (quotes.length) { %><div class="card"><h2>Cenové ponuky</h2><table class="compact"><% for (const q of quotes) { %><tr><td><a href="/quotes/<%= q.id %>"><%= q.number %></a></td><td><%= U.fmtDate(q.date) %></td><td class="num"><%= U.money(q.subtotal) %></td><td><span class="badge <%= { draft: 'muted', sent: 'info', accepted: 'ok', rejected: 'danger', invoiced: 'ok' }[q.status] || 'muted' %>"><%= q.status %></span></td></tr><% } %></table></div><% } %>
<div class="card"><h2>Faktúry</h2>
<% if (!invoices.length) { %><p class="muted">Zatiaľ žiadne faktúry.</p><% } else { %>
<table class="compact"><tr><th>Číslo</th><th>Vystavená</th><th>Splatnosť</th><th class="num">Spolu</th><th class="num">Zádržné</th><th class="num">Zostáva</th><th>Stav</th></tr>
<% for (const i of invoices) { const st = INV.invoiceStatusLabel(i); %><tr><td><a href="/invoices/<%= i.id %>"><%= i.number %></a></td><td><%= U.fmtDate(i.issue_date) %></td><td><%= U.fmtDate(i.due_date) %></td><td class="num"><%= U.money(i.total) %></td><td class="num"><%= i.retention_amount ? U.money(INV.retentionRemaining(i)) : '–' %></td><td class="num"><%= U.money(INV.remaining(i)) %></td><td><span class="badge <%= st.cls %>"><%= st.text %></span></td></tr><% } %></table><% } %>
</div>
<%- include('../partials/footer') %>
