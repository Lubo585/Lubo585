<%- include('../partials/header') %>
<div class="topbar"><h1>Ubytovanie pracovníkov</h1><a href="/lodging/new" class="btn">+ Nová ubytovňa</a></div>
<div class="card"><% if (!lodgings.length) { %><p class="muted">Zatiaľ žiadne ubytovne. Evidujte ubytovne v Nemecku, kto kde býva, náklady a či sa ubytovanie zráža pracovníkovi alebo preúčtuje klientovi.</p><% } else { %>
<table><tr><th>Ubytovňa</th><th>Mesto</th><th class="num">Obsadenosť</th><th class="num">€/noc</th><th class="num">Fixný nájom / mes.</th><th>Prenajímateľ</th><th></th></tr>
<% for (const l of lodgings) { const full = l.capacity && l.occupied >= l.capacity; %><tr style="<%= l.active ? '' : 'opacity:.5' %>"><td><a href="/lodging/<%= l.id %>"><b><%= l.name %></b></a><br><span class="small muted"><%= l.address || '' %></span></td><td><%= l.city %> <span class="muted small"><%= l.country %></span></td><td class="num"><b style="<%= full ? 'color:var(--danger)' : '' %>"><%= l.occupied %></b> / <%= l.capacity || '–' %></td><td class="num"><%= U.money(l.price_per_night) %></td><td class="num"><%= U.money(l.monthly_cost) %></td><td class="small"><%= l.landlord || '' %> <%= l.contact || '' %></td><td class="right"><a href="/lodging/<%= l.id %>/edit" class="btn sm secondary">Upraviť</a></td></tr><% } %></table><% } %></div>
<div class="card"><div class="topbar"><h2>Náklady na ubytovanie za mesiac</h2><form method="get" class="row" style="align-items:flex-end"><div class="field"><input type="month" name="month" value="<%= month %>"></div><div class="field" style="flex:0"><button class="btn secondary">Zobraziť</button></div></form></div>
  <p>Pobyty: <b><%= U.money(cost.total) %></b> · fixné nájmy aktívnych ubytovní: <b><%= U.money(cost.fixed) %></b></p>
  <% if (cost.rows.length) { %><table class="compact"><tr><th>Pracovník</th><th>Ubytovňa</th><th>Obdobie</th><th class="num">Nocí</th><th class="num">Suma</th><th>Platí</th></tr><% for (const r of cost.rows) { %><tr><td><a href="/workers/<%= r.worker_id %>"><%= r.last_name %> <%= r.first_name %></a></td><td><%= r.lodging_name %></td><td class="small"><%= U.fmtDate(r.date_from) %> – <%= r.date_to ? U.fmtDate(r.date_to) : 'trvá' %></td><td class="num"><%= r.nights %></td><td class="num"><%= U.money(r.cost) %></td><td><span class="badge <%= r.charge_to === 'worker' ? 'warn' : r.charge_to === 'client' ? 'info' : 'muted' %>"><%= CHARGE[r.charge_to] %></span></td></tr><% } %></table>
  <form method="post" action="/lodging/deductions" class="mt"><input type="hidden" name="month" value="<%= month %>"><button class="btn sm secondary" onclick="return confirm('Vytvoriť zrážky za ubytovanie pre pracovníkov so zrážkou za <%= month %>?')">Vytvoriť zrážky pracovníkom za <%= month %></button> <span class="help">Zrážky sa objavia v mesačnom vyúčtovaní pracovníka.</span></form><% } %>
</div>
<%- include('../partials/footer') %>
