<%- include('../partials/header') %>
<h1><%= title %></h1>
<form method="post" action="/clients/save" class="card" style="max-width:820px">
  <input type="hidden" name="id" value="<%= c.id || '' %>">
  <div class="field"><label>Názov firmy *</label><input type="text" name="name" value="<%= c.name || '' %>" required></div>
  <div class="row"><div class="field"><label>IČO</label><input type="text" name="ico" value="<%= c.ico || '' %>"></div><div class="field"><label>DIČ</label><input type="text" name="dic" value="<%= c.dic || '' %>"></div><div class="field"><label>IČ DPH</label><input type="text" name="ic_dph" value="<%= c.ic_dph || '' %>"></div></div>
  <div class="field"><label>Adresa (sídlo)</label><input type="text" name="address" value="<%= c.address || '' %>"></div>
  <div class="row"><div class="field"><label>Kontaktná osoba</label><input type="text" name="contact_person" value="<%= c.contact_person || '' %>"></div><div class="field"><label>E-mail (faktúry a upomienky)</label><input type="email" name="email" value="<%= c.email || '' %>"></div><div class="field"><label>Telefón</label><input type="text" name="phone" value="<%= c.phone || '' %>"></div></div>
  <h2 class="mt">Platobné podmienky</h2>
  <div class="row">
    <div class="field"><label>Splatnosť faktúr (dní)</label><input type="number" name="due_days" value="<%= c.due_days ?? 14 %>"></div>
    <div class="field"><label>Zádržné %</label><input type="number" step="0.01" name="retention_percent" value="<%= c.retention_percent ?? 0 %>"><div class="help">Časť faktúry, ktorú klient zadrží (napr. 5 % alebo 10 %).</div></div>
    <div class="field"><label>Zádržné splatné po (mesiacov)</label><input type="number" name="retention_months" value="<%= c.retention_months ?? 0 %>"><div class="help">Od dátumu vystavenia faktúry.</div></div>
  </div>
  <div class="row">
    <div class="field"><label>Skonto %</label><input type="number" step="0.01" name="skonto_percent" value="<%= c.skonto_percent ?? 0 %>"><div class="help">Zľava za skorú úhradu.</div></div>
    <div class="field"><label>Skonto pri úhrade do (dní od vystavenia)</label><input type="number" name="skonto_days" value="<%= c.skonto_days ?? 0 %>"></div>
    <div class="field"><label>&nbsp;</label><label class="check"><input type="checkbox" name="reverse_charge" <%= c.reverse_charge ? 'checked' : '' %>> Prenesenie daňovej povinnosti (§ 69 ods. 12 zákona o DPH) – faktúry bez DPH</label></div>
  </div>
  <div class="field"><label>Poznámka</label><textarea name="note"><%= c.note || '' %></textarea></div>
  <div class="field"><label class="check"><input type="checkbox" name="active" <%= c.active ? 'checked' : '' %>> Aktívny</label></div>
  <div class="actions"><button class="btn" type="submit">Uložiť</button><a href="<%= c.id ? '/clients/' + c.id : '/clients' %>" class="btn secondary">Zrušiť</a></div>
</form>
<%- include('../partials/footer') %>
