<%- include('../partials/header') %>
<div class="topbar"><div><h1><%= l.name %></h1><div class="muted"><%= l.address || '' %> <%= l.city || '' %> · kapacita <%= l.capacity || '–' %> · <%= U.money(l.price_per_night) %>/noc<%= l.monthly_cost ? ' · nájom ' + U.money(l.monthly_cost) + '/mes.' : '' %><%= l.landlord ? ' · ' + l.landlord + ' ' + (l.contact || '') : '' %></div></div><div class="actions"><a href="/lodging" class="btn secondary">← Zoznam</a><a href="/lodging/<%= l.id %>/edit" class="btn secondary">Upraviť</a></div></div>
<div class="grid grid-2">
  <div class="card"><h2>Aktuálne ubytovaní (<%= current.length %><%= l.capacity ? ' / ' + l.capacity : '' %>)</h2>
    <% if (!current.length) { %><p class="muted">Nikto.</p><% } else { %><table class="compact"><% for (const s of current) { %><tr><td><a href="/workers/<%= s.worker_id %>"><%= s.last_name %> <%= s.first_name %></a></td><td class="small">od <%= U.fmtDate(s.date_from) %></td><td><span class="badge <%= s.charge_to === 'worker' ? 'warn' : 'muted' %>"><%= CHARGE[s.charge_to] %></span></td><td class="right nowrap"><form class="inline" method="post" action="/lodging/<%= l.id %>/stays/<%= s.id %>/end"><input type="date" name="date_to" value="<%= U.today() %>" style="width:140px;display:inline"> <button class="btn sm secondary">Ukončiť</button></form></td></tr><% } %></table><% } %>
    <h3 class="mt">Ubytovať pracovníkov</h3>
    <form method="post" action="/lodging/<%= l.id %>/stays/save"><div class="row" style="align-items:flex-end"><div class="field" style="flex:2"><select name="worker_id" multiple size="5"><% for (const w of workers) { %><option value="<%= w.id %>"><%= w.last_name %> <%= w.first_name %></option><% } %></select></div><div class="field"><label>Od</label><input type="date" name="date_from" value="<%= U.today() %>" required><label class="mt">Do (voliteľné)</label><input type="date" name="date_to"></div><div class="field"><label>€/noc</label><input type="number" step="0.01" name="price_per_night" value="<%= l.price_per_night %>"><label class="mt">Kto platí</label><select name="charge_to"><% for (const [k, v] of Object.entries(CHARGE)) { %><option value="<%= k %>"><%= v %></option><% } %></select></div></div><div class="field"><input type="text" name="note" placeholder="izba, poznámka"></div><button class="btn sm">Ubytovať</button></form>
  </div>
  <div class="card"><h2>História pobytov</h2>
    <% if (!stays.length) { %><p class="muted">Žiadne.</p><% } else { %><table class="compact"><% for (const s of stays) { %><tr><td><%= s.last_name %> <%= s.first_name %></td><td class="small nowrap"><%= U.fmtDate(s.date_from) %> – <%= s.date_to ? U.fmtDate(s.date_to) : 'trvá' %></td><td class="num"><%= U.money(s.price_per_night) %></td><td class="small muted"><%= CHARGE[s.charge_to] %> <%= s.note || '' %></td><td class="right"><form class="inline" method="post" action="/lodging/<%= l.id %>/stays/<%= s.id %>/delete" onsubmit="return confirm('Odstrániť pobyt?')"><button class="btn sm danger">×</button></form></td></tr><% } %></table><% } %>
    <div class="mt"><%- include('../partials/attachments', { entityType: 'lodging', entityId: l.id, back: '/lodging/' + l.id }) %></div>
  </div>
</div>
<%- include('../partials/footer') %>
