<%- include('../partials/header') %>
<% const st = STATUSES[o.status] || STATUSES.open; %>
<div class="topbar"><div><h1><%= o.name %> <span class="badge <%= st[1] %>"><%= st[0] %></span></h1><div class="muted"><a href="/clients/<%= o.client_id %>"><%= o.client_name %></a><%= o.address ? ' · ' + o.address : '' %> · sadzba <%= U.money(o.hourly_rate) %>/h<% if (o.start_date || o.end_date) { %> · <%= o.start_date ? U.fmtDate(o.start_date) : '?' %> – <%= o.end_date ? U.fmtDate(o.end_date) : '?' %><% } %></div></div>
<div class="actions"><a href="/orders" class="btn secondary">← Zákazky</a><a href="/tasks/new?client_id=<%= o.client_id %>&site_id=<%= o.id %>" class="btn secondary">+ Úloha</a><form class="inline" method="post" action="/timesheets/new"><input type="hidden" name="site_id" value="<%= o.id %>"><input type="hidden" name="week" value="<%= U.today() %>"><button class="btn secondary">Hodinový lístok tento týždeň</button></form><% if (o.hours_uninvoiced > 0) { %><a href="/invoices/from-timesheets?client_id=<%= o.client_id %>&site_id=<%= o.id %>" class="btn">Fakturovať <%= U.hours(o.hours_uninvoiced) %> h</a><% } %><a href="/orders/<%= o.id %>/edit" class="btn secondary">Upraviť</a></div></div>
<div class="grid grid-4">
  <div class="kpi"><div class="label">Pracovníci teraz</div><div class="value" style="<%= o.workers_needed > o.workers_now && o.status !== 'finished' ? 'color:var(--danger)' : '' %>"><%= o.workers_now %> <span class="muted" style="font-size:14px">/ <%= o.workers_needed || '–' %> potrebných</span></div><div class="sub">podľa lístkov za posledné 2 týždne</div></div>
  <div class="kpi"><div class="label">Odpracované hodiny</div><div class="value"><%= U.hours(o.hours_total) %></div><div class="sub">posledný lístok <%= o.last_week ? U.fmtDate(o.last_week) : '–' %></div></div>
  <div class="kpi <%= o.hours_uninvoiced > 0 ? 'warn' : '' %>"><div class="label">Nevyfakturované hodiny</div><div class="value"><%= U.hours(o.hours_uninvoiced) %></div><div class="sub">≈ <%= U.money(o.hours_uninvoiced * o.hourly_rate) %></div></div>
  <div class="kpi"><div class="label">Stav zákazky</div><div class="value" style="font-size:16px"><form method="post" action="/orders/<%= o.id %>/status" class="row"><select name="status" onchange="this.form.submit()"><% for (const [k, v] of Object.entries(STATUSES)) { %><option value="<%= k %>" <%= o.status===k?'selected':'' %>><%= v[0] %></option><% } %></select></form></div></div>
</div>
<div class="grid grid-2 mt">
  <div class="card">
    <h2>Pracovníci na zákazke</h2>
    <% if (!workers.length) { %><p class="muted">Zatiaľ žiadni pracovníci. Vytvorte hodinový lístok a pridajte ich.</p><% } else { %><table class="compact"><tr><th>Pracovník</th><th>Profesia</th><th class="num">Hodiny</th><th>Naposledy</th></tr><% for (const w of workers) { %><tr><td><a href="/workers/<%= w.id %>/edit"><%= w.last_name %> <%= w.first_name %></a></td><td><%= w.position %></td><td class="num"><%= U.hours(w.hours) %></td><td><%= U.fmtDate(w.last_week) %></td></tr><% } %></table><% } %>
    <% if (o.description || o.contact_person || o.note) { %><h3 class="mt">Info</h3><% if (o.contact_person) { %><p class="small">Kontakt na stavbe: <b><%= o.contact_person %></b> <%= o.contact_phone || '' %></p><% } %><% if (o.description) { %><p class="small" style="white-space:pre-wrap"><%= o.description %></p><% } %><% if (o.note) { %><p class="small muted"><%= o.note %></p><% } %><% } %>
  </div>
  <div class="card">
    <h2>Otvorené úlohy</h2>
    <% if (!tasks.length) { %><p class="muted">Žiadne.</p><% } else { %><table class="compact"><% for (const t of tasks) { const ts = TASK_STATUSES[t.status]; %><tr><td><a href="/tasks/<%= t.id %>"><%= t.title %></a></td><td><span class="badge <%= ts[1] %>"><%= ts[0] %></span></td><td><%= t.to_name || t.to_user || '' %></td><td class="nowrap"><%= t.due_date ? U.fmtDate(t.due_date) : '' %></td></tr><% } %></table><% } %>
    <h2 class="mt">Hodinové lístky</h2>
    <% if (!sheets.length) { %><p class="muted">Žiadne.</p><% } else { %><table class="compact"><% for (const s of sheets) { const wk = U.isoWeek(s.week_start); const ss = { draft: ['warn','Rozpracovaný'], approved: ['info','Schválený'], invoiced: ['ok','Vyfakturovaný'] }[s.status]; %><tr><td><a href="/timesheets/<%= s.id %>">T<%= wk.week %>/<%= wk.year %></a> <span class="small muted"><%= U.fmtDate(s.week_start) %></span></td><td class="num"><%= s.workers %> prac.</td><td class="num"><%= U.hours(s.hours) %> h</td><td><span class="badge <%= ss[0] %>"><%= ss[1] %></span></td></tr><% } %></table><% } %>
  </div>
</div>
<% if (invoices.length) { %><div class="card"><h2>Faktúry k zákazke</h2><table class="compact"><tr><th>Číslo</th><th>Vystavená</th><th>Splatnosť</th><th class="num">Spolu</th><th class="num">Zostáva</th><th>Stav</th></tr><% for (const i of invoices) { const il = INV.invoiceStatusLabel(i); %><tr><td><a href="/invoices/<%= i.id %>"><%= i.number %></a></td><td><%= U.fmtDate(i.issue_date) %></td><td><%= U.fmtDate(i.due_date) %></td><td class="num"><%= U.money(i.total) %></td><td class="num"><%= U.money(INV.remaining(i)) %></td><td><span class="badge <%= il.cls %>"><%= il.text %></span></td></tr><% } %></table></div><% } %>
<%- include('../partials/footer') %>
