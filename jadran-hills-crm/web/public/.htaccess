# Jadran Hills – nastavenie servera Apache. Iné servery súbor ignorujú;
# všetko je v blokoch IfModule, takže chýbajúci modul stránku nezhodí.

# Web beží len cez zabezpečené pripojenie: adresy http sa presmerujú na https.
# (Hosting ukončuje šifrovanie pred serverom, preto sa pozerá aj na hlavičku
# X-Forwarded-Proto.)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Úvodnou stránkou každého priečinka je index.html (aj keď hosting v priečinku
# necháva vlastnú predvolenú stránku index.php).
<IfModule mod_dir.c>
  DirectoryIndex index.html
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # Stránky sa pri každej návšteve overia – nová verzia sa ukáže hneď.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript image/svg+xml application/json
</IfModule>
