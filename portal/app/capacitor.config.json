{
  "appId": "sk.nazovportalu.app",
  "appName": "NazovPortalu",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https",
    "hostname": "app.nazovportalu.sk"
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0f0a0d"
  },
  "ios": {
    "contentInset": "automatic",
    "backgroundColor": "#0f0a0d",
    "limitsNavigationsToAppBoundDomains": true
  },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 800, "backgroundColor": "#0f0a0d", "launchAutoHide": true },
    "StatusBar": { "style": "DARK", "backgroundColor": "#0f0a0d" },
    "PushNotifications": { "presentationOptions": ["badge", "sound", "alert"] }
  }
}
