<%- include('../partials/header') %>
<div class="topbar"><h1>Vyúčtovanie pracovníkov</h1><form method="get" class="row" style="align-items:flex-end"><div class="field"><input type="month" name="month" value="<%= month %>"></div><div class="field" style="flex:0"><button class="btn secondary">Zobraziť</button></div><div class="field" style="flex:0"><a href="/settlements/new?month=<%= month %>" class="btn">+ Nové vyúčtovanie</a></div></form></div>
<div class="grid grid-3"><div class="kpi"><div class="label">Hodiny <%= month %></div><div class="value"><%= U.hours(sums.hours) %></div></div><div class="kpi"><div class="label">K výplate spolu</div><div class="value"><%= U.money(sums.total) %></div></div><div class="kpi <%= sums.total - sums.paid > 0 ? 'warn' : 'ok' %>"><div class="label">Ešte nevyplatené</div><div class="value"><%= U.money(sums.total - sums.paid) %></div></div></div>
<% if (pending.length) { %><div class="card mt"><h2>Pracovníci s hodinami bez vyúčtovania za <%= month %> (<%= pending.length %>)</h2>
  <form method="post" action="/settlements/create"><input type="hidden" name="month" value="<%= month %>"><div class="row" style="flex-wrap:wrap"><% for (const w of pending) { %><label class="check" style="flex:0 0 auto;min-width:220px"><input type="checkbox" name="worker_id" value="<%= w.id %>" checked> <%= w.last_name %> <%= w.first_name %> <span class="muted small">(<%= w.wage_rate ? U.money(w.wage_rate) + '/h' : 'bez mzdovej sadzby!' %>)</span></label><% } %></div><button class="btn sm mt">Vytvoriť vyúčtovania pre označených</button> <span class="help">Použije sa mzda z karty pracovníka, diéty podľa dní v DE a nevyúčtované zálohy/zrážky.</span></form></div><% } %>
<div class="card mt"><% if (!list.length) { %><p class="muted">Žiadne vyúčtovania za <%= month %>.</p><% } else { %>
<table><tr><th>Pracovník</th><th class="num">Hodiny</th><th class="num">Mzda</th><th class="num">Diéty</th><th class="num">Bonusy</th><th class="num">Zálohy</th><th class="num">Zrážky</th><th class="num">K výplate</th><th>Stav</th></tr>
<% for (const s of list) { const st = STATUS[s.status]; %><tr><td><a href="/settlements/<%= s.id %>"><b><%= s.last_name %> <%= s.first_name %></b></a></td><td class="num"><%= U.hours(s.hours) %></td><td class="num"><%= U.money(s.wage_total) %></td><td class="num"><%= U.money(s.per_diem_total) %></td><td class="num"><%= U.money(s.bonus_total) %></td><td class="num">− <%= U.money(s.advances_total) %></td><td class="num">− <%= U.money(s.deductions_total) %></td><td class="num"><b><%= U.money(s.total_due) %></b></td><td><span class="badge <%= st[0] %>"><%= st[1] %></span></td></tr><% } %></table><% } %></div>
<%- include('../partials/footer') %>
