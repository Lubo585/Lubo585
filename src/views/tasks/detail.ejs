<%- include('../partials/header') %>
<% const st = STATUSES[t.status]; const pr = PRIORITIES[t.priority] || PRIORITIES.normal; const late = t.due_date && t.due_date < U.today() && !['done','cancelled'].includes(t.status); %>
<div class="topbar"><div><h1><%= t.title %> <span class="badge <%= st[1] %>"><%= st[0] %></span> <span class="badge <%= pr[1] %>"><%= pr[0] %> priorita</span></h1>
<div class="muted">Zadal <b><%= t.by_name || t.by_user || '–' %></b> dňa <%= t.created_at.slice(0, 10).split('-').reverse().join('.') %> → rieši <b><%= t.to_name || t.to_user || '–' %></b><% if (t.due_date) { %> · termín <b style="<%= late ? 'color:var(--danger)' : '' %>"><%= U.fmtDate(t.due_date) %><%= late ? ' (po termíne)' : '' %></b><% } %><% if (t.done_at) { %> · hotová <%= U.fmtDate(t.done_at) %><% } %></div></div>
<div class="actions"><a href="/tasks" class="btn secondary">← Zoznam</a><a href="/tasks/<%= t.id %>/edit" class="btn secondary">Upraviť</a><form class="inline" method="post" action="/tasks/<%= t.id %>/delete" onsubmit="return confirm('Odstrániť úlohu?')"><button class="btn danger">Odstrániť</button></form></div></div>
<div class="grid grid-2">
  <div class="card">
    <% if (t.description) { %><p style="white-space:pre-wrap"><%= t.description %></p><% } else { %><p class="muted">Bez podrobností.</p><% } %>
    <% if (t.client_name || t.site_name || t.w_last) { %><p class="small muted">Týka sa: <% if (t.client_name) { %><a href="/clients/<%= t.client_id %>"><%= t.client_name %></a> <% } %><% if (t.site_name) { %>· <a href="/orders/<%= t.site_id %>"><%= t.site_name %></a> <% } %><% if (t.w_last) { %>· <a href="/workers/<%= t.worker_id %>/edit"><%= t.w_last %> <%= t.w_first %></a><% } %></p><% } %>
    <h3 class="mt">Zmeniť stav</h3>
    <form method="post" action="/tasks/<%= t.id %>/status" class="row" style="align-items:flex-end">
      <div class="field"><select name="status"><% for (const [k, v] of Object.entries(STATUSES)) { %><option value="<%= k %>" <%= t.status===k?'selected':'' %>><%= v[0] %></option><% } %></select></div>
      <div class="field" style="flex:2"><input type="text" name="text" placeholder="poznámka k zmene (voliteľné)"></div>
      <div class="field" style="flex:0"><button class="btn">Uložiť stav</button></div>
    </form>
  </div>
  <div class="card">
    <h2>Priebeh a komentáre</h2>
    <% for (const c of comments) { %><div style="padding:6px 0;border-bottom:1px solid var(--line)"><span class="small muted"><%= c.created_at %> · <%= c.name || c.username || '–' %></span><br><% if (c.type !== 'comment') { %><i class="muted"><%= c.text %></i><% } else { %><span style="white-space:pre-wrap"><%= c.text %></span><% } %></div><% } %>
    <form method="post" action="/tasks/<%= t.id %>/comment" class="mt"><div class="field"><textarea name="text" placeholder="Napísať komentár…" required></textarea></div><button class="btn sm">Pridať komentár</button></form>
  </div>
</div>
<%- include('../partials/footer') %>
