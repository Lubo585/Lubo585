<%- include('../partials/header') %>
<h1><%= title %></h1>
<form method="post" action="/orders/save" class="card" style="max-width:820px">
  <input type="hidden" name="id" value="<%= o.id || '' %>">
  <div class="row"><div class="field" style="flex:2"><label>Názov zákazky / stavby *</label><input type="text" name="name" value="<%= o.name || '' %>" required placeholder="napr. Bytový dom Petržalka – hrubá stavba"></div><div class="field"><label>Klient *</label><select name="client_id" required><option value="">– vyberte –</option><% for (const c of clients) { %><option value="<%= c.id %>" <%= o.client_id==c.id?'selected':'' %>><%= c.name %></option><% } %></select></div></div>
  <div class="row"><div class="field"><label>Stav</label><select name="status"><% for (const [k, v] of Object.entries(STATUSES)) { %><option value="<%= k %>" <%= (o.status||'open')===k?'selected':'' %>><%= v[0] %></option><% } %></select></div><div class="field"><label>Začiatok</label><input type="date" name="start_date" value="<%= o.start_date || '' %>"></div><div class="field"><label>Predpokladaný koniec</label><input type="date" name="end_date" value="<%= o.end_date || '' %>"></div><div class="field"><label>Potrebný počet pracovníkov</label><input type="number" name="workers_needed" value="<%= o.workers_needed ?? 0 %>"></div></div>
  <div class="row"><div class="field"><label>Sadzba € / hod *</label><input type="number" step="0.01" name="hourly_rate" value="<%= o.hourly_rate ?? '' %>" required><div class="help">Fakturačná sadzba za hodinu pracovníka na tejto zákazke.</div></div><div class="field"><label>Sadzba nadčas € / hod</label><input type="number" step="0.01" name="overtime_rate" value="<%= o.overtime_rate ?? '' %>"></div></div>
  <div class="field"><label>Adresa stavby</label><input type="text" name="address" value="<%= o.address || '' %>"></div>
  <div class="row"><div class="field"><label>Kontaktná osoba na stavbe (stavbyvedúci)</label><input type="text" name="contact_person" value="<%= o.contact_person || '' %>"></div><div class="field"><label>Telefón</label><input type="text" name="contact_phone" value="<%= o.contact_phone || '' %>"></div></div>
  <div class="field"><label>Popis prác / požiadavky (profesie, náradie, ubytovanie…)</label><textarea name="description"><%= o.description || '' %></textarea></div>
  <div class="field"><label>Poznámka</label><input type="text" name="note" value="<%= o.note || '' %>"></div>
  <div class="actions"><button class="btn" type="submit">Uložiť zákazku</button><a href="<%= o.id ? '/orders/' + o.id : '/orders' %>" class="btn secondary">Zrušiť</a></div>
</form>
<%- include('../partials/footer') %>
