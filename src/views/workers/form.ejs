<%- include('../partials/header') %>
<h1><%= title %></h1>
<form method="post" action="/workers/save" class="card" style="max-width:900px">
  <input type="hidden" name="id" value="<%= w.id || '' %>">
  <h2>Osobné údaje</h2>
  <div class="row"><div class="field"><label>Meno *</label><input type="text" name="first_name" value="<%= w.first_name || '' %>" required></div><div class="field"><label>Priezvisko *</label><input type="text" name="last_name" value="<%= w.last_name || '' %>" required></div><div class="field"><label>Dátum narodenia</label><input type="date" name="birth_date" value="<%= w.birth_date || '' %>"></div></div>
  <div class="row"><div class="field"><label>Národnosť</label><input type="text" name="nationality" value="<%= w.nationality || '' %>" placeholder="Ukrajina, Slovensko…"></div><div class="field"><label>&nbsp;</label><label class="check"><input type="checkbox" name="eu_citizen" <%= w.eu_citizen ? 'checked' : '' %>> Občan EÚ (bez potreby povolenia na pobyt a víza Vander Elst)</label></div></div>
  <div class="row"><div class="field" style="flex:2"><label>Adresa trvalého pobytu</label><input type="text" name="address" value="<%= w.address || '' %>"></div><div class="field"><label>Číslo dokladu (pas / OP)</label><input type="text" name="id_number" value="<%= w.id_number || '' %>"></div></div>
  <div class="row"><div class="field"><label>Telefón</label><input type="text" name="phone" value="<%= w.phone || '' %>"></div><div class="field"><label>E-mail</label><input type="email" name="email" value="<%= w.email || '' %>"></div><div class="field"><label>Kontakt pre núdzové prípady</label><input type="text" name="emergency_contact" value="<%= w.emergency_contact || '' %>"></div></div>
  <h2 class="mt">Práca</h2>
  <div class="row"><div class="field"><label>Profesia</label><input type="text" name="position" value="<%= w.position || '' %>" placeholder="murár, tesár, železiar, pomocný pracovník…"></div><div class="field"><label>Mzdová skupina (Lohngruppe)</label><input type="text" name="lohngruppe" value="<%= w.lohngruppe || '' %>" placeholder="napr. LG 2"></div><div class="field"><label>Nemčina</label><select name="german_level"><% for (const l of ['', 'žiadna', 'A1', 'A2', 'B1', 'B2', 'C1', 'rodený hovorca']) { %><option value="<%= l %>" <%= (w.german_level||'')===l?'selected':'' %>><%= l || '–' %></option><% } %></select></div></div>
  <div class="row"><div class="field"><label>Nástup</label><input type="date" name="hired_at" value="<%= w.hired_at || '' %>"></div><div class="field"><label>Typ zmluvy</label><select name="contract_type"><% for (const [k, v] of [['', '–'], ['hpp', 'Pracovná zmluva (TPP)'], ['dohoda', 'Dohoda'], ['szco', 'SZČO / živnosť'], ['agentura', 'Agentúrne zamestnávanie']]) { %><option value="<%= k %>" <%= (w.contract_type||'')===k?'selected':'' %>><%= v %></option><% } %></select></div><div class="field"><label>Veľkosti (OOPP: obuv, odev)</label><input type="text" name="sizes" value="<%= w.sizes || '' %>" placeholder="obuv 43, bunda L"></div></div>
  <h2 class="mt">Sadzby a vyúčtovanie</h2>
  <div class="row">
    <div class="field"><label>Nákladová sadzba € / hod *</label><input type="number" step="0.01" name="hourly_cost" value="<%= w.hourly_cost ?? 0 %>" required><div class="help">Celkový náklad firmy za hodinu (mzda + odvody + réžia). Používa sa na výpočet zisku.</div></div>
    <div class="field"><label>Mzda pracovníkovi € / hod</label><input type="number" step="0.01" name="wage_rate" value="<%= w.wage_rate ?? '' %>"><div class="help">Suma, ktorá sa pracovníkovi vypláca za hodinu (pre mesačné vyúčtovanie).</div></div>
    <div class="field"><label>Fakturačná sadzba € / hod (voliteľné)</label><input type="number" step="0.01" name="hourly_rate" value="<%= w.hourly_rate ?? '' %>"><div class="help">Ak je vyplnená, prebíja sadzbu zákazky / cenníka.</div></div>
  </div>
  <div class="row"><div class="field"><label>Zrážka za ubytovanie € / mesiac (predvolená)</label><input type="number" step="0.01" name="lodging_deduction" value="<%= w.lodging_deduction ?? 0 %>"></div><div class="field"><label>&nbsp;</label><label class="check"><input type="checkbox" name="per_diem" <%= w.per_diem ? 'checked' : '' %>> Nárok na zahraničné stravné (diéty) za dni v DE</label></div><div class="field"><label>IBAN na výplatu</label><input type="text" name="iban" value="<%= w.iban || '' %>"></div></div>
  <div class="field"><label>Poznámka</label><textarea name="note"><%= w.note || '' %></textarea></div>
  <div class="field"><label class="check"><input type="checkbox" name="active" <%= w.active ? 'checked' : '' %>> Aktívny</label></div>
  <div class="actions"><button class="btn" type="submit">Uložiť</button><a href="<%= w.id ? '/workers/' + w.id : '/workers' %>" class="btn secondary">Zrušiť</a></div>
</form>
<%- include('../partials/footer') %>
