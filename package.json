{
  "name": "agentura-app",
  "version": "1.0.0",
  "description": "Firemná aplikácia pre personálnu agentúru v stavebníctve: hodinové lístky, náklady, fakturácia, upomienky a párovanie bankových výpisov",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning server.js",
    "dev": "node --no-warnings=ExperimentalWarning --watch server.js",
    "test": "node --no-warnings=ExperimentalWarning --test test/*.test.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "fast-xml-parser": "^4.5.0",
    "imapflow": "^1.0.171",
    "mailparser": "^3.7.1",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16"
  }
}
