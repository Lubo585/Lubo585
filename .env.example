# ===== Telegram (https://my.telegram.org -> API development tools) =====
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
# Token bota od @BotFather. Bot musí byť admin vo VIP skupine.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
# Tvoje Telegram user ID (zisti cez @userinfobot). Sem chodia náhľady na schválenie.
OWNER_CHAT_ID=111111111
# ID alebo @username platenej VIP skupiny/kanála (napr. -1001234567890)
VIP_TELEGRAM_CHAT_ID=-1001234567890

# Odkiaľ chodia tipy od kamaráta:
#   forward  – kamarátove správy jednoducho prepošleš botovi (najjednoduchšie)
#   userbot  – tvoj vlastný účet počúva priamo v chate s kamarátom (SOURCE_CHAT)
SOURCE_MODE=forward
# @username, telefón alebo ID kamaráta / skupiny, kde tipy posiela (len pre userbot)
SOURCE_CHAT=@kamarat

# ===== Discord – Server settings -> Integrations -> Webhooks =====
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# ===== Postiz (IG / X / FB) – voliteľné, https://postiz.com =====
# npm i -g postiz ; postiz auth:login ; postiz integrations:list
POSTIZ_API_KEY=
POSTIZ_INSTAGRAM_ID=
POSTIZ_X_ID=
POSTIZ_FACEBOOK_ID=

# ===== AI parser – voliteľné =====
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
