<%- include('../partials/header') %>
<h1>Nastavenia</h1>
<div class="tabs"><% for (const [k, l] of [['company','Firma'],['germany','Nemecko / compliance'],['invoicing','Fakturácia'],['reminders','Upomienky'],['email','Odosielanie e-mailov (SMTP)'],['bank','Bankový e-mail (IMAP)'],['ai','AI asistent'],['account','Používatelia a prístupy'],['backup','Zálohy a verzia'],['log','Denník']]) { %><a href="/settings?tab=<%= k %>" class="<%= tab===k?'active':'' %>"><%= l %></a><% } %></div>

<% if (tab === 'company') { %>
<form method="post" action="/settings/save" class="card" style="max-width:800px"><input type="hidden" name="tab" value="company">
  <div class="field"><label>Názov firmy</label><input type="text" name="company_name" value="<%= s.company_name %>"></div>
  <div class="field"><label>Adresa (sídlo)</label><input type="text" name="company_address" value="<%= s.company_address %>"></div>
  <div class="row"><div class="field"><label>IČO</label><input type="text" name="company_ico" value="<%= s.company_ico %>"></div><div class="field"><label>DIČ</label><input type="text" name="company_dic" value="<%= s.company_dic %>"></div><div class="field"><label>IČ DPH</label><input type="text" name="company_ic_dph" value="<%= s.company_ic_dph %>"></div></div>
  <div class="row"><div class="field"><label>IBAN</label><input type="text" name="company_iban" value="<%= s.company_iban %>"></div><div class="field"><label>BIC / SWIFT</label><input type="text" name="company_bic" value="<%= s.company_bic %>"></div></div>
  <div class="row"><div class="field"><label>E-mail</label><input type="text" name="company_email" value="<%= s.company_email %>"></div><div class="field"><label>Telefón</label><input type="text" name="company_phone" value="<%= s.company_phone %>"></div></div>
  <div class="field"><label>Zápis v registri (text na faktúre)</label><input type="text" name="company_register" value="<%= s.company_register %>" placeholder="Zapísaná v OR OS Bratislava I, oddiel Sro, vložka č. 12345/B"></div>
  <div class="row"><div class="field"><label>Krajina</label><input type="text" name="company_country" value="<%= s.company_country %>"></div><div class="field" style="flex:3"><label>Verejná adresa aplikácie (pre odkazy v e-mailoch a pozvánkach)</label><input type="text" name="app_url" value="<%= s.app_url %>" placeholder="https://app.vasafirma.sk"></div></div>
  <button class="btn">Uložiť</button></form>

<% } else if (tab === 'invoicing') { %>
<form method="post" action="/settings/save" class="card" style="max-width:800px"><input type="hidden" name="tab" value="invoicing">
  <div class="row"><div class="field"><label>Predpona čísla faktúry</label><input type="text" name="invoice_prefix" value="<%= s.invoice_prefix %>" placeholder="napr. FA"></div><div class="field"><label>Formát číslovania</label><input type="text" name="invoice_number_format" value="<%= s.invoice_number_format %>"><div class="help">{YYYY} rok, {YY} dvojciferný rok, {NNNN} poradové číslo v roku. Variabilný symbol = číslice z čísla faktúry.</div></div></div>
  <div class="row"><div class="field"><label>Predvolená sadzba DPH %</label><input type="number" step="0.01" name="default_vat_rate" value="<%= s.default_vat_rate %>"></div><div class="field"><label>Predvolená splatnosť (dní)</label><input type="number" name="default_due_days" value="<%= s.default_due_days %>"></div><div class="field"><label>Predvolená sadzba za hodinu €</label><input type="number" step="0.01" name="default_hourly_rate" value="<%= s.default_hourly_rate %>"></div></div>
  <div class="field"><label>Tolerancia pri párovaní súm (€)</label><input type="number" step="0.01" name="match_amount_tolerance" value="<%= s.match_amount_tolerance %>"><div class="help">Rozdiel medzi prijatou sumou a sumou faktúry, ktorý sa ešte považuje za úplnú úhradu.</div></div>
  <button class="btn">Uložiť</button></form>

<% } else if (tab === 'reminders') { %>
<div class="grid grid-2">
<form method="post" action="/settings/save" class="card"><input type="hidden" name="tab" value="reminders"><input type="hidden" name="_form_reminder_enabled" value="1">
  <div class="field"><label class="check"><input type="checkbox" name="reminder_enabled" <%= s.reminder_enabled === '1' ? 'checked' : '' %>> Odosielať upomienky automaticky (denne o 8:00)</label></div>
  <div class="field"><label>Dni po splatnosti pre 1., 2., 3. … upomienku</label><input type="text" name="reminder_days" value="<%= s.reminder_days %>"><div class="help">Čiarkou oddelené, napr. 3,14,30. Každý stupeň sa odošle iba raz.</div></div>
  <div class="field"><label>Kópia (CC) na</label><input type="text" name="reminder_cc" value="<%= s.reminder_cc %>" placeholder="vas@email.sk"></div>
  <div class="field"><label>Predmet</label><input type="text" name="reminder_subject" value="<%= s.reminder_subject %>"></div>
  <div class="field"><label>Text upomienky</label><textarea name="reminder_body" style="min-height:260px"><%= s.reminder_body %></textarea><div class="help">Premenné: {LEVEL} {NUMBER} {VS} {ISSUE_DATE} {DUE_DATE} {AMOUNT} {REMAINING} {DAYS_OVERDUE} {IBAN} {COMPANY} {CLIENT}</div></div>
  <button class="btn">Uložiť</button></form>
<div class="card"><h2>Upomienky na odoslanie dnes</h2>
  <% if (!due.length) { %><p class="muted">Žiadne faktúry nečakajú na upomienku.</p><% } else { %><table class="compact"><tr><th>Faktúra</th><th>Po splatnosti</th><th>Stupeň</th><th class="num">Zostáva</th></tr><% for (const d of due) { %><tr><td><a href="/invoices/<%= d.invoice.id %>"><%= d.invoice.number %></a></td><td><%= INV.daysOverdue(d.invoice) %> dní</td><td><%= d.level %>.</td><td class="num"><%= U.money(INV.remaining(d.invoice)) %></td></tr><% } %></table>
  <form method="post" action="/settings/run-reminders" class="mt"><button class="btn" onclick="return confirm('Odoslať všetky čakajúce upomienky teraz?')">Odoslať teraz</button></form><% } %>
  <p class="help mt">Pre odosielanie musí byť nastavený SMTP server a klient musí mať vyplnený e-mail.</p></div>
</div>

<% } else if (tab === 'email') { %>
<form method="post" action="/settings/save" class="card" style="max-width:800px"><input type="hidden" name="tab" value="email"><input type="hidden" name="_form_smtp_secure" value="1">
  <div class="row"><div class="field" style="flex:2"><label>SMTP server</label><input type="text" name="smtp_host" value="<%= s.smtp_host %>" placeholder="smtp.gmail.com"></div><div class="field"><label>Port</label><input type="number" name="smtp_port" value="<%= s.smtp_port %>"></div><div class="field"><label>&nbsp;</label><label class="check"><input type="checkbox" name="smtp_secure" <%= s.smtp_secure === '1' ? 'checked' : '' %>> SSL (port 465)</label></div></div>
  <div class="row"><div class="field"><label>Používateľ</label><input type="text" name="smtp_user" value="<%= s.smtp_user %>"></div><div class="field"><label>Heslo <%= s.smtp_pass ? '(uložené, ponechajte prázdne pre zachovanie)' : '' %></label><input type="password" name="smtp_pass" value="" autocomplete="new-password"></div></div>
  <div class="field"><label>Odosielateľ (From)</label><input type="text" name="smtp_from" value="<%= s.smtp_from %>" placeholder="Agentúra s.r.o. <fakturacia@firma.sk>"></div>
  <div class="help">Pre Gmail použite „heslo aplikácie“ (Google účet → Zabezpečenie → Heslá aplikácií), server smtp.gmail.com, port 587.</div>
  <button class="btn mt">Uložiť</button></form>
<form method="post" action="/settings/test-smtp" class="card row" style="max-width:800px;align-items:flex-end"><div class="field"><label>Testovací e-mail poslať na</label><input type="email" name="to" placeholder="vas@email.sk"></div><div class="field" style="flex:0"><button class="btn secondary">Otestovať SMTP</button></div></form>

<% } else if (tab === 'bank') { %>
<form method="post" action="/settings/save" class="card" style="max-width:800px"><input type="hidden" name="tab" value="bank"><input type="hidden" name="_form_imap_enabled" value="1"><input type="hidden" name="_form_imap_secure" value="1">
  <p class="help">Vytvorte si samostatnú e-mailovú schránku (napr. <b>vypisy@vasafirma.sk</b>) a v internetbankingu nastavte zasielanie výpisov na túto adresu vo formáte <b>XML (camt.053)</b> alebo CSV. Aplikácia bude schránku pravidelne kontrolovať, neprečítané e-maily s prílohami importovať a prijaté platby párovať s faktúrami.</p>
  <div class="field"><label class="check"><input type="checkbox" name="imap_enabled" <%= s.imap_enabled === '1' ? 'checked' : '' %>> Automaticky sťahovať výpisy z e-mailu</label></div>
  <div class="row"><div class="field" style="flex:2"><label>IMAP server</label><input type="text" name="imap_host" value="<%= s.imap_host %>" placeholder="imap.gmail.com"></div><div class="field"><label>Port</label><input type="number" name="imap_port" value="<%= s.imap_port %>"></div><div class="field"><label>&nbsp;</label><label class="check"><input type="checkbox" name="imap_secure" <%= s.imap_secure !== '0' ? 'checked' : '' %>> SSL/TLS</label></div></div>
  <div class="row"><div class="field"><label>Používateľ (e-mail)</label><input type="text" name="imap_user" value="<%= s.imap_user %>"></div><div class="field"><label>Heslo <%= s.imap_pass ? '(uložené)' : '' %></label><input type="password" name="imap_pass" value="" autocomplete="new-password"></div></div>
  <div class="row"><div class="field"><label>Priečinok</label><input type="text" name="imap_folder" value="<%= s.imap_folder %>"></div><div class="field"><label>Iba e-maily od (filter odosielateľa)</label><input type="text" name="imap_from_filter" value="<%= s.imap_from_filter %>" placeholder="@tatrabanka.sk"></div><div class="field"><label>Interval kontroly (minúty)</label><input type="number" name="imap_interval_minutes" value="<%= s.imap_interval_minutes %>"></div></div>
  <% if (s.imap_last_check) { %><p class="small muted">Posledná kontrola: <%= s.imap_last_check.replace('T',' ').slice(0,19) %> <%= s.imap_last_error ? '– chyba: ' + s.imap_last_error : '– OK' %></p><% } %>
  <button class="btn">Uložiť</button></form>
<form method="post" action="/settings/test-imap" class="card" style="max-width:800px"><button class="btn secondary">Otestovať IMAP pripojenie</button> <a href="/bank" class="btn secondary">Prejsť na Banka a platby</a></form>

<% } else if (tab === 'ai') { %>
<form method="post" action="/settings/save" class="card" style="max-width:800px"><input type="hidden" name="tab" value="ai">
  <p class="help">AI asistent vyhľadáva faktúry, zákazky, hodinové lístky, pracovníkov, úlohy a platby a radí, ako aplikáciu používať. Používa Claude API od spoločnosti Anthropic. API kľúč získate na <b>console.anthropic.com</b> (API Keys). Do AI služby sa posielajú iba údaje, ktoré asistent potrebuje na odpoveď (výsledky vyhľadávania), nie celá databáza. Asistent dáta nemení.</p>
  <div class="field"><label>API kľúč <%= s.ai_api_key ? '(uložený, ponechajte prázdne pre zachovanie)' : (process.env.ANTHROPIC_API_KEY ? '(použije sa premenná prostredia ANTHROPIC_API_KEY)' : '') %></label><input type="password" name="ai_api_key" value="" autocomplete="new-password" placeholder="sk-ant-..."></div>
  <div class="field"><label>Model</label><input type="text" name="ai_model" value="<%= s.ai_model %>"><div class="help">Predvolený <code>claude-opus-5-5</code>. Lacnejšia alternatíva: <code>claude-sonnet-5-5</code>.</div></div>
  <button class="btn">Uložiť</button></form>
<div class="row" style="max-width:800px"><form method="post" action="/settings/test-ai" class="card"><button class="btn secondary">Otestovať pripojenie</button> <a href="/assistant" class="btn secondary">Otvoriť asistenta</a></form>
<% if (s.ai_api_key) { %><form method="post" action="/settings/clear-ai-key" class="card" onsubmit="return confirm('Odstrániť uložený API kľúč?')"><button class="btn danger">Odstrániť API kľúč</button></form><% } %></div>

<% } else if (tab === 'account') { %>
<div class="card">
  <h2>Používatelia</h2>
  <table class="compact"><tr><th>Meno</th><th>Prihlasovacie meno</th><th>E-mail</th><th>Rola</th><th>Posledné prihlásenie</th><th></th></tr>
  <% for (const u of users) { %><tr style="<%= u.active ? '' : 'opacity:.5' %>"><td><b><%= u.name || '' %></b><% if (u.last_name) { %><br><span class="small muted">pracovník <%= u.last_name %> <%= u.first_name %></span><% } %></td><td><%= u.username %></td><td><%= u.email || '' %></td>
    <td><form method="post" action="/settings/users/<%= u.id %>/update" class="row" style="gap:4px"><input type="hidden" name="action" value="role"><select name="role" <%= u.id === user.id ? 'disabled' : '' %> onchange="this.form.querySelector('[name=worker_id]').hidden = this.value !== 'worker'"><% for (const [k, v] of Object.entries(ROLES)) { %><option value="<%= k %>" <%= u.role===k?'selected':'' %>><%= v %></option><% } %></select><select name="worker_id" <%= u.role === 'worker' ? '' : 'hidden' %>><option value="">– pracovník –</option><% for (const w of workers) { %><option value="<%= w.id %>" <%= u.worker_id==w.id?'selected':'' %>><%= w.last_name %> <%= w.first_name %></option><% } %></select><% if (u.id !== user.id) { %><button class="btn sm secondary">OK</button><% } %></form></td>
    <td class="small muted"><%= u.last_login || '–' %></td>
    <td class="right nowrap"><% if (u.id !== user.id) { %><form class="inline" method="post" action="/settings/users/<%= u.id %>/update"><input type="hidden" name="action" value="<%= u.active ? 'deactivate' : 'activate' %>"><button class="btn sm secondary"><%= u.active ? 'Deaktivovať' : 'Aktivovať' %></button></form> <form class="inline" method="post" action="/settings/users/<%= u.id %>/update" onsubmit="const p=prompt('Nové heslo (min. 8 znakov) pre '+'<%= u.username %>'); if(!p) return false; this.password.value=p;"><input type="hidden" name="action" value="password"><input type="hidden" name="password"><button class="btn sm secondary">Heslo</button></form> <form class="inline" method="post" action="/settings/users/<%= u.id %>/update" onsubmit="return confirm('Odstrániť používateľa?')"><input type="hidden" name="action" value="delete"><button class="btn sm danger">×</button></form><% } else { %><span class="muted small">vy</span><% } %></td></tr><% } %></table>
  <p class="help mt">Roly: <b>Administrátor</b> všetko · <b>Kancelária</b> všetko okrem nastavení a banky · <b>Dispečer</b> pracovníci, zákazky, lístky, plánovanie, compliance · <b>Účtovníctvo</b> fakturácia, banka, náklady, prehľady · <b>Pracovník</b> iba vlastný portál (hodiny, vyúčtovanie, doklady).</p>
</div>
<div class="grid grid-2">
<form method="post" action="/settings/invites/add" class="card"><h2>Pozvať nového používateľa</h2>
  <p class="help">Vytvorí sa odkaz, ktorý pošlete dotyčnej osobe. Po otvorení si sama zvolí meno a heslo. Odkaz platí 14 dní.</p>
  <div class="row"><div class="field"><label>Meno</label><input type="text" name="name"></div><div class="field"><label>E-mail</label><input type="email" name="email"></div></div>
  <div class="row"><div class="field"><label>Rola</label><select name="role" onchange="inv_w.hidden = this.value !== 'worker'"><% for (const [k, v] of Object.entries(ROLES)) { %><option value="<%= k %>"><%= v %></option><% } %></select></div><div class="field" id="inv_w" hidden><label>Prepojiť s pracovníkom</label><select name="worker_id"><option value="">–</option><% for (const w of workers) { %><option value="<%= w.id %>"><%= w.last_name %> <%= w.first_name %></option><% } %></select></div></div>
  <button class="btn">Vytvoriť pozvánku</button>
  <% if (invites.length) { %><h3 class="mt">Aktívne pozvánky</h3><table class="compact"><% for (const i of invites) { %><tr><td><%= i.name || i.email || '–' %> <span class="badge"><%= ROLES[i.role] %></span></td><td><input type="text" readonly value="<%= baseUrl %>/register/<%= i.token %>" onclick="this.select()" style="font-size:11px"></td><td class="right"><form class="inline" method="post" action="/settings/invites/<%= i.id %>/delete"><button class="btn sm danger">×</button></form></td></tr><% } %></table><% } %>
</form>
<div>
<form method="post" action="/settings/password" class="card"><h2>Zmena môjho hesla (<%= user.username %>)</h2>
  <div class="field"><label>Pôvodné heslo</label><input type="password" name="old_password" required></div><div class="field"><label>Nové heslo</label><input type="password" name="new_password" required minlength="8"></div><div class="field"><label>Nové heslo znova</label><input type="password" name="new_password2" required></div><button class="btn">Zmeniť heslo</button></form>
<form method="post" action="/settings/users/add" class="card"><h2>Pridať používateľa priamo (s heslom)</h2>
  <div class="row"><div class="field"><label>Prihlasovacie meno</label><input type="text" name="username" required></div><div class="field"><label>Meno</label><input type="text" name="name"></div></div>
  <div class="row"><div class="field"><label>E-mail</label><input type="email" name="email"></div><div class="field"><label>Rola</label><select name="role"><% for (const [k, v] of Object.entries(ROLES)) { %><option value="<%= k %>"><%= v %></option><% } %></select></div><div class="field"><label>Pracovník (pre rolu Pracovník)</label><select name="worker_id"><option value="">–</option><% for (const w of workers) { %><option value="<%= w.id %>"><%= w.last_name %> <%= w.first_name %></option><% } %></select></div></div>
  <div class="field"><label>Heslo (min. 8 znakov)</label><input type="password" name="password" required minlength="8"></div><button class="btn">Pridať</button></form>
</div>
</div>

<% } else if (tab === 'germany') { %>
<form method="post" action="/settings/save" class="card" style="max-width:860px"><input type="hidden" name="tab" value="germany">
  <h2>Povolenia a registrácie</h2>
  <div class="row"><div class="field"><label>Povolenie na prenájom zamestnancov (AÜG-Erlaubnis / povolenie ADZ) – číslo</label><input type="text" name="aug_permit_number" value="<%= s.aug_permit_number %>"></div><div class="field"><label>Platné do</label><input type="date" name="aug_permit_valid_until" value="<%= s.aug_permit_valid_until %>"></div></div>
  <div class="row"><div class="field"><label>Freistellungsbescheinigung § 48b EStG – číslo</label><input type="text" name="freistellung_number" value="<%= s.freistellung_number %>"><div class="help">Oslobodenie od 15 % Bauabzugsteuer. Bez platného potvrdenia nemecký klient zráža 15 % z faktúry za stavebné práce.</div></div><div class="field"><label>Platné do</label><input type="date" name="freistellung_valid_until" value="<%= s.freistellung_valid_until %>"></div></div>
  <div class="row"><div class="field"><label>Číslo u SOKA-BAU (Urlaubskasse)</label><input type="text" name="soka_number" value="<%= s.soka_number %>"></div><div class="field"><label>Zahraničné stravné pre Nemecko € / deň</label><input type="number" step="0.01" name="per_diem_rate_de" value="<%= s.per_diem_rate_de %>"></div><div class="field"><label>Štandardný pracovný deň (hod)</label><input type="number" step="0.5" name="standard_hours_per_day" value="<%= s.standard_hours_per_day %>"><div class="help">Hodiny nad tento limit sa počítajú ako nadčas.</div></div></div>
  <div class="row"><div class="field"><label>Upozorňovať na expiráciu dokladov (dní vopred)</label><input type="number" name="doc_alert_days" value="<%= s.doc_alert_days %>"></div><div class="field"><label>Predvolený jazyk dokladov pre klientov</label><select name="default_language_documents"><option value="sk" <%= s.default_language_documents==='sk'?'selected':'' %>>slovenčina</option><option value="de" <%= s.default_language_documents==='de'?'selected':'' %>>nemčina</option></select></div></div>
  <h2 class="mt">Upomienky v nemčine (Mahnung)</h2>
  <div class="row"><div class="field"><label>Úrok z omeškania % p. a.</label><input type="number" step="0.01" name="default_interest_rate" value="<%= s.default_interest_rate %>"><div class="help">§ 288 BGB: 9 bodov nad základnou sadzbou Bundesbank (B2B). Hodnotu aktualizujte podľa aktuálnej sadzby.</div></div><div class="field"><label>Paušálna náhrada € (§ 288 ods. 5 BGB)</label><input type="number" step="0.01" name="reminder_fee_de" value="<%= s.reminder_fee_de %>"></div></div>
  <div class="field"><label>Predmet (DE)</label><input type="text" name="reminder_subject_de" value="<%= s.reminder_subject_de %>"></div>
  <div class="field"><label>Text (DE)</label><textarea name="reminder_body_de" style="min-height:220px"><%= s.reminder_body_de %></textarea><div class="help">Premenné ako pri slovenskej upomienke, navyše {INTEREST} a {FEE}. Použije sa pre klientov s jazykom „nemčina“.</div></div>
  <button class="btn">Uložiť</button></form>

<% } else if (tab === 'backup') { %>
<div class="grid grid-2">
<div class="card"><h2>Zálohy databázy</h2>
  <p class="help">Databáza je jeden súbor. Záloha sa robí automaticky každú noc o 2:30 a vždy pred aktualizáciou aplikácie na novú verziu (údaje sa pri update nikdy nestrácajú, nové verzie iba pridávajú tabuľky a stĺpce). Ponecháva sa posledných 30 záloh. Odporúčame zálohy pravidelne kopírovať mimo servera.</p>
  <form method="post" action="/settings/save" class="field"><input type="hidden" name="tab" value="backup"><input type="hidden" name="_form_backup_enabled" value="1"><label class="check"><input type="checkbox" name="backup_enabled" <%= s.backup_enabled === '1' ? 'checked' : '' %>> Automatická nočná záloha</label> <button class="btn sm secondary">Uložiť</button></form>
  <div class="actions"><form method="post" action="/settings/backup-now"><button class="btn">Zálohovať teraz</button></form><a href="/settings/backup/download" class="btn secondary">Stiahnuť aktuálnu databázu</a></div>
  <% if (backups.length) { %><table class="compact mt"><% for (const b of backups) { %><tr><td><%= b.name %></td><td class="num"><%= (b.size / 1024 / 1024).toFixed(2) %> MB</td><td class="right"><a href="/settings/backup/download?name=<%= b.name %>" class="btn sm secondary">↓</a></td></tr><% } %></table><% } %>
</div>
<div class="card"><h2>Začiatok ostrej prevádzky</h2>
  <p class="help">Po vyskúšaní ukážky vymažte všetky dáta (klienti, pracovníci, lístky, faktúry, platby…). Používatelia a nastavenia firmy ostanú. Pred vymazaním sa automaticky vytvorí záloha. Existujúcich klientov a pracovníkov potom nahráte z CSV: <a href="/settings/import">Import dát</a>.</p>
  <form method="post" action="/settings/reset-data" onsubmit="return confirm('Naozaj vymazať všetky dáta? Vytvorí sa záloha.')"><div class="row" style="align-items:flex-end"><div class="field"><label>Napíšte VYMAZAT</label><input type="text" name="confirm" autocomplete="off"></div><div class="field" style="flex:0"><button class="btn danger">Vymazať všetky dáta</button></div></div></form>
  <p class="help mt">Kontrolný zoznam pred ostrou prevádzkou je v súbore <b>OSTRA_PREVADZKA.md</b>.</p>
</div>
<div class="card"><h2>Verzia</h2><p>Aplikácia <b><%= appVersion %></b>, schéma databázy <b>v<%= schemaVersion %></b>.</p>
  <p class="help">Aktualizácia: na serveri stiahnite novú verziu a reštartujte aplikáciu (pri Dockeri <code>docker compose pull && docker compose up -d</code> alebo <code>git pull && docker compose up -d --build</code>). Pri štarte sa automaticky vytvorí záloha a aplikujú sa migrácie, existujúce dáta sa zachovajú.</p></div>
</div>

<% } else if (tab === 'log') { %>
<div class="card"><table class="compact"><% for (const l of logs) { %><tr><td class="nowrap muted small"><%= l.created_at %></td><td><span class="badge"><%= l.type %></span></td><td><%= l.message %></td></tr><% } %></table><% if (!logs.length) { %><p class="muted">Denník je prázdny.</p><% } %></div>
<% } %>
<%- include('../partials/footer') %>
