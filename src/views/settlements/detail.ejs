<%- include('../partials/header') %>
<% const st = STATUS[s.status]; const locked = s.status === 'paid'; %>
<div class="topbar"><div><h1>Vyúčtovanie <%= s.month %> – <%= s.last_name %> <%= s.first_name %> <span class="badge <%= st[0] %>"><%= st[1] %></span></h1><div class="muted"><%= s.position || '' %> · IBAN <%= s.iban || '–' %><%= s.paid_at ? ' · vyplatené ' + U.fmtDate(s.paid_at) : '' %></div></div>
<div class="actions"><a href="/settlements?month=<%= s.month %>" class="btn secondary">← Zoznam</a><a href="/settlements/<%= s.id %>/print?lang=sk" target="_blank" class="btn secondary">Výplatná páska SK</a><a href="/settlements/<%= s.id %>/print?lang=uk" target="_blank" class="btn secondary">UA</a><a href="/settlements/<%= s.id %>/print?lang=de" target="_blank" class="btn secondary">DE</a><% if (!locked) { %><form class="inline" method="post" action="/settlements/<%= s.id %>/delete" onsubmit="return confirm('Odstrániť vyúčtovanie?')"><button class="btn danger">Odstrániť</button></form><% } %></div></div>
<div class="grid grid-2">
  <form method="post" action="/settlements/<%= s.id %>/update" class="card"><h2>Výpočet</h2>
    <div class="row"><div class="field"><label>Hodiny</label><input type="number" step="0.25" name="hours" value="<%= s.hours %>" <%= locked ? 'readonly' : '' %>></div><div class="field"><label>Mzda €/h</label><input type="number" step="0.01" name="wage_rate" value="<%= s.wage_rate %>" <%= locked ? 'readonly' : '' %>></div><div class="field"><label>Diéty dní</label><input type="number" name="per_diem_days" value="<%= s.per_diem_days %>" <%= locked ? 'readonly' : '' %>></div><div class="field"><label>Diéty €/deň</label><input type="number" step="0.01" name="per_diem_rate" value="<%= s.per_diem_rate %>" <%= locked ? 'readonly' : '' %>></div></div>
    <table class="compact"><tr><td>Mzda <%= U.hours(s.hours) %> h × <%= U.money(s.wage_rate) %></td><td class="num"><%= U.money(s.wage_total) %></td></tr><tr><td>Diéty <%= s.per_diem_days %> dní × <%= U.money(s.per_diem_rate) %></td><td class="num"><%= U.money(s.per_diem_total) %></td></tr><tr><td>Bonusy / doplatky</td><td class="num"><%= U.money(s.bonus_total) %></td></tr><tr><td>Zálohy</td><td class="num">− <%= U.money(s.advances_total) %></td></tr><tr><td>Zrážky</td><td class="num">− <%= U.money(s.deductions_total) %></td></tr><tr class="total"><td>K výplate</td><td class="num"><%= U.money(s.total_due) %></td></tr></table>
    <div class="field mt"><label>Poznámka</label><input type="text" name="note" value="<%= s.note || '' %>" <%= locked ? 'readonly' : '' %>></div>
    <% if (!locked) { %><button class="btn secondary">Prepočítať</button><% } %>
  </form>
  <div>
    <div class="card"><h2>Zálohy, zrážky, bonusy v tomto vyúčtovaní</h2>
      <% if (!s.transactions.length) { %><p class="muted">Žiadne.</p><% } else { %><table class="compact"><% for (const t of s.transactions) { %><tr><td><%= U.fmtDate(t.date) %></td><td><span class="badge <%= t.type === 'bonus' ? 'ok' : (t.type === 'advance' ? 'warn' : 'muted') %>"><%= { advance: 'záloha', deduction: 'zrážka', bonus: 'bonus' }[t.type] %></span> <%= t.description || '' %></td><td class="num"><%= U.money(t.amount) %></td><td><% if (!locked) { %><form class="inline" method="post" action="/settlements/<%= s.id %>/item/<%= t.id %>/delete"><button class="btn sm danger">×</button></form><% } %></td></tr><% } %></table><% } %>
      <% if (!locked) { %><form method="post" action="/settlements/<%= s.id %>/item" class="row mt" style="align-items:flex-end"><div class="field"><input type="date" name="date" value="<%= U.today() %>"></div><div class="field"><select name="type"><option value="advance">záloha</option><option value="deduction">zrážka</option><option value="bonus">bonus</option></select></div><div class="field"><input type="number" step="0.01" name="amount" placeholder="€" required></div><div class="field" style="flex:2"><input type="text" name="description" placeholder="popis"></div><div class="field" style="flex:0"><button class="btn sm">Pridať</button></div></form><% } %>
    </div>
    <div class="card"><h2>Stav</h2>
      <form method="post" action="/settlements/<%= s.id %>/status" class="row" style="align-items:flex-end"><div class="field"><select name="status"><% for (const [k, v] of Object.entries(STATUS)) { %><option value="<%= k %>" <%= s.status===k?'selected':'' %>><%= v[1] %></option><% } %></select></div><div class="field"><label>Dátum výplaty</label><input type="date" name="paid_at" value="<%= s.paid_at || U.today() %>"></div><div class="field"><label class="check"><input type="checkbox" name="as_expense" checked> pri vyplatení zapísať do nákladov (Mzdy)</label></div><div class="field" style="flex:0"><button class="btn">Uložiť</button></div></form>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
