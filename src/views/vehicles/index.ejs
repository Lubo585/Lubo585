<%- include('../partials/header') %>
<div class="topbar"><h1>Vozidlá a kniha jázd</h1><form method="get" class="row" style="align-items:flex-end"><div class="field"><input type="month" name="month" value="<%= month %>"></div><div class="field" style="flex:0"><button class="btn secondary">Zobraziť</button></div></form></div>
<% if (alerts.length) { %><div class="flash warn">Končí STK/EK alebo poistenie: <%= alerts.map(v => v.plate + ' (' + (v.inspection_until ? 'STK ' + U.fmtDate(v.inspection_until) : '') + (v.insurance_until ? ' poistenie ' + U.fmtDate(v.insurance_until) : '') + ')').join(', ') %></div><% } %>
<div class="grid grid-2">
  <div class="card"><h2>Vozidlá</h2>
    <% if (vehicles.length) { %><table class="compact"><tr><th>ŠPZ</th><th>Vozidlo</th><th class="num">Miest</th><th>STK</th><th>Poistenie</th><th class="num">km <%= month %></th><th class="num">€</th><th></th></tr><% for (const v of vehicles) { %><tr style="<%= v.active ? '' : 'opacity:.5' %>"><td><b><%= v.plate %></b></td><td><%= v.name %></td><td class="num"><%= v.seats %></td><td class="small"><%= v.inspection_until ? U.fmtDate(v.inspection_until) : '–' %></td><td class="small"><%= v.insurance_until ? U.fmtDate(v.insurance_until) : '–' %></td><td class="num"><%= U.hours(v.km_month) %></td><td class="num"><%= U.money(v.cost_month) %></td><td class="right nowrap"><button type="button" class="btn sm secondary" onclick='editV(<%- JSON.stringify(v).replace(/</g, "\\u003c").replace(/'/g, "\\u0027") %>)'>Upraviť</button> <form class="inline" method="post" action="/vehicles/<%= v.id %>/delete" onsubmit="return confirm('Odstrániť vozidlo?')"><button class="btn sm danger">×</button></form></td></tr><% } %></table><% } else { %><p class="muted">Žiadne vozidlá.</p><% } %>
    <details class="mt" id="v-form"><summary>+ Pridať vozidlo</summary><form method="post" action="/vehicles/save" class="mt"><input type="hidden" name="id" id="v_id">
      <div class="row"><div class="field"><label>ŠPZ *</label><input type="text" name="plate" id="v_plate" required></div><div class="field" style="flex:2"><label>Vozidlo</label><input type="text" name="name" id="v_name" placeholder="VW Transporter"></div><div class="field"><label>Miest</label><input type="number" name="seats" id="v_seats" value="9"></div></div>
      <div class="row"><div class="field"><label>STK/EK do</label><input type="date" name="inspection_until" id="v_insp"></div><div class="field"><label>Poistenie do</label><input type="date" name="insurance_until" id="v_ins"></div><div class="field"><label>Poznámka</label><input type="text" name="note" id="v_note"></div></div>
      <label class="check"><input type="checkbox" name="active" id="v_active" checked> Aktívne</label><button class="btn sm mt">Uložiť vozidlo</button></form></details>
  </div>
  <form method="post" action="/vehicles/trips/save" class="card"><h2>Zapísať jazdu</h2><input type="hidden" name="trip_id" id="t_id">
    <div class="row"><div class="field"><label>Vozidlo</label><select name="vehicle_id" id="t_vehicle"><option value="">–</option><% for (const v of vehicles) { %><option value="<%= v.id %>"><%= v.plate %> <%= v.name %></option><% } %></select></div><div class="field"><label>Vodič</label><select name="driver_worker_id" id="t_driver"><option value="">– iný –</option><% for (const w of workers) { %><option value="<%= w.id %>"><%= w.last_name %> <%= w.first_name %></option><% } %></select></div><div class="field"><label>Vodič (meno, ak nie je pracovník)</label><input type="text" name="driver_name" id="t_dname"></div></div>
    <div class="row"><div class="field"><label>Dátum</label><input type="date" name="date" id="t_date" value="<%= U.today() %>" required></div><div class="field"><label>Návrat</label><input type="date" name="date_to" id="t_to"></div><div class="field"><label>Odkiaľ</label><input type="text" name="route_from" id="t_from" placeholder="Bratislava"></div><div class="field"><label>Kam</label><input type="text" name="route_to" id="t_rto" placeholder="München"></div></div>
    <div class="row"><div class="field"><label>km</label><input type="number" step="1" name="km" id="t_km"></div><div class="field"><label>Náklady (PHM, mýto) €</label><input type="number" step="0.01" name="cost" id="t_cost"></div><div class="field"><label>Zákazka</label><select name="site_id" id="t_site"><option value="">–</option><% for (const s of sites) { %><option value="<%= s.id %>"><%= s.name %></option><% } %></select></div><div class="field"><label>Účel</label><input type="text" name="purpose" id="t_purpose" placeholder="preprava pracovníkov"></div></div>
    <div class="row"><div class="field" style="flex:2"><label>Spolucestujúci</label><input type="text" name="passengers" id="t_pass"></div><div class="field"><label>&nbsp;</label><label class="check"><input type="checkbox" name="as_expense" checked> zaevidovať náklady do Nákladov</label></div></div>
    <button class="btn sm">Uložiť jazdu</button></form>
</div>
<div class="card"><h2>Kniha jázd <%= month %></h2>
  <% if (!trips.length) { %><p class="muted">Žiadne jazdy.</p><% } else { %><table class="compact"><tr><th>Dátum</th><th>Vozidlo</th><th>Vodič</th><th>Trasa</th><th class="num">km</th><th class="num">€</th><th>Účel / zákazka</th><th></th></tr><% let km = 0, cost = 0; for (const t of trips) { km += t.km; cost += t.cost; %><tr><td class="nowrap"><%= U.fmtDate(t.date) %><%= t.date_to ? ' – ' + U.fmtDate(t.date_to) : '' %></td><td><%= t.plate || '' %></td><td><%= t.last_name ? t.last_name + ' ' + t.first_name : t.driver_name %></td><td><%= t.route_from %> → <%= t.route_to %><% if (t.passengers) { %><br><span class="small muted"><%= t.passengers %></span><% } %></td><td class="num"><%= U.hours(t.km) %></td><td class="num"><%= U.money(t.cost) %></td><td class="small"><%= t.purpose || '' %> <%= t.site_name ? '· ' + t.site_name : '' %></td><td class="right nowrap"><button type="button" class="btn sm secondary" onclick='editT(<%- JSON.stringify(t).replace(/</g, "\\u003c").replace(/'/g, "\\u0027") %>)'>Upraviť</button> <form class="inline" method="post" action="/vehicles/trips/<%= t.id %>/delete"><input type="hidden" name="back" value="/vehicles?month=<%= month %>"><button class="btn sm danger">×</button></form></td></tr><% } %><tr class="total"><td colspan="4">Spolu</td><td class="num"><%= U.hours(km) %></td><td class="num"><%= U.money(cost) %></td><td colspan="2"></td></tr></table><% } %>
</div>
<script>
function editV(v){const f=document.getElementById('v-form');f.open=true;v_id.value=v.id;v_plate.value=v.plate;v_name.value=v.name||'';v_seats.value=v.seats;v_insp.value=v.inspection_until||'';v_ins.value=v.insurance_until||'';v_note.value=v.note||'';v_active.checked=!!v.active;}
function editT(t){t_id.value=t.id;t_vehicle.value=t.vehicle_id||'';t_driver.value=t.driver_worker_id||'';t_dname.value=t.driver_name||'';t_date.value=t.date;t_to.value=t.date_to||'';t_from.value=t.route_from||'';t_rto.value=t.route_to||'';t_km.value=t.km||'';t_cost.value=t.cost||'';t_site.value=t.site_id||'';t_purpose.value=t.purpose||'';t_pass.value=t.passengers||'';window.scrollTo(0,0);}
</script>
<%- include('../partials/footer') %>
