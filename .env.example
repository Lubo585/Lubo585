# Verejná doména aplikácie (pre Caddy a HTTPS). Pre lokálny beh nechajte localhost.
DOMAIN=app.vasafirma.sk
# Port webového servera (iba pri behu bez Dockeru)
PORT=3000
# Tajný kľúč pre prihlásenie (ZMEŇTE na dlhý náhodný reťazec, napr. `openssl rand -hex 32`)
SESSION_SECRET=zmen-ma-na-nahodny-retazec
# Heslo prvého administrátora (použije sa iba pri prvom spustení s prázdnou databázou)
ADMIN_PASSWORD=admin
# Cesta k databáze SQLite (v Dockeri sa nastavuje automaticky na /app/data/app.db)
DB_PATH=./data/app.db
# Cookie iba cez HTTPS (1 pri verejnom nasadení za Caddy/nginx)
COOKIE_SECURE=1
# Voliteľne: API kľúč pre AI asistenta (dá sa zadať aj v Nastaveniach)
# ANTHROPIC_API_KEY=sk-ant-...
