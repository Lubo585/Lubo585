<%- include('../partials/header') %>
<div class="topbar"><h1>Transakcia #<%= tx.id %> – <%= U.money(tx.amount) %></h1><a href="/bank" class="btn secondary">← Späť</a></div>
<div class="grid grid-2">
  <div class="card"><h2>Údaje z banky</h2>
    <table class="compact"><tr><td class="muted">Dátum</td><td><%= U.fmtDate(tx.date) %></td></tr><tr><td class="muted">Suma</td><td><b><%= U.money(tx.amount) %></b> <%= tx.currency %></td></tr><tr><td class="muted">Protistrana</td><td><%= tx.counterparty_name || '–' %><br><span class="small"><%= tx.counterparty_iban || '' %></span></td></tr><tr><td class="muted">VS / SS / KS</td><td><%= tx.variable_symbol || '–' %> / <%= tx.specific_symbol || '–' %> / <%= tx.constant_symbol || '–' %></td></tr><tr><td class="muted">Správa</td><td><%= tx.message || '–' %></td></tr><tr><td class="muted">Referencia</td><td class="small"><%= tx.bank_reference || '–' %></td></tr>
    <tr><td class="muted">Stav</td><td><% if (tx.matched_invoice_id) { %>spárované s <a href="/invoices/<%= tx.matched_invoice_id %>"><%= tx.invoice_number %></a> (<%= tx.match_status %>) <span class="muted small"><%= tx.match_note %></span><% } else { %><%= tx.match_status === 'ignored' ? 'ignorované' : 'nespárované' %><% } %></td></tr></table>
    <div class="actions mt">
      <% if (tx.matched_invoice_id || tx.match_status === 'ignored') { %><form method="post" action="/bank/<%= tx.id %>/unmatch"><button class="btn secondary">Zrušiť spárovanie / obnoviť</button></form><% } %>
      <% if (tx.match_status === 'unmatched' && tx.amount > 0) { %><form method="post" action="/bank/<%= tx.id %>/ignore"><input type="hidden" name="note" value="Nesúvisí s faktúrami"><button class="btn secondary">Ignorovať (nesúvisí s faktúrami)</button></form><% } %>
    </div>
    <% if (tx.amount < 0 && tx.match_status === 'unmatched') { %>
    <form method="post" action="/bank/<%= tx.id %>/expense" class="mt"><h3>Zaevidovať ako náklad</h3><div class="row" style="align-items:flex-end"><div class="field"><label>Kategória</label><select name="category"><% for (const c of U.EXPENSE_CATEGORIES) { %><option><%= c %></option><% } %></select></div><div class="field"><label>DPH %</label><input type="number" step="0.01" name="vat_rate" value="23"></div><div class="field" style="flex:0"><button class="btn">Vytvoriť náklad</button></div></div></form>
    <% } %>
  </div>
  <div class="card">
    <% if (tx.amount > 0) { %>
    <h2>Navrhované faktúry</h2>
    <% if (!candidates.length) { %><p class="muted">Žiadny vhodný kandidát (nezhoduje sa VS, suma ani názov klienta).</p><% } else { %>
    <table class="compact"><tr><th>Faktúra</th><th>Klient</th><th class="num">Zostáva</th><th>Zhoda</th><th></th></tr>
    <% for (const c of candidates) { %><tr><td><a href="/invoices/<%= c.invoice.id %>"><%= c.invoice.number %></a></td><td><%= c.invoice.client_name %></td><td class="num"><%= c.kind === 'retention' ? U.money(c.retentionRemaining) + ' <span class="small muted">zádržné</span>' : U.money(c.remaining) %></td><td><span class="badge <%= c.score >= 80 ? 'ok' : (c.score >= 50 ? 'warn' : 'muted') %>"><%= c.score %></span> <span class="small muted"><%= c.reasons.join(', ') %></span></td>
    <td class="right"><% if (tx.match_status === 'unmatched') { %><form method="post" action="/bank/<%= tx.id %>/match"><input type="hidden" name="invoice_id" value="<%= c.invoice.id %>"><input type="hidden" name="kind" value="<%= c.kind %>"><button class="btn sm">Spárovať<%= c.kind === 'retention' ? ' (zádržné)' : '' %></button></form><% } %></td></tr><% } %></table><% } %>
    <% if (tx.match_status === 'unmatched') { %>
    <h3 class="mt">Spárovať ručne s inou faktúrou</h3>
    <form method="post" action="/bank/<%= tx.id %>/match" class="row" style="align-items:flex-end">
      <div class="field" style="flex:2"><select name="invoice_id" required><option value="">– vyberte faktúru –</option><% for (const i of open) { %><option value="<%= i.id %>"><%= i.number %> – <%= i.client_name %> (zostáva <%= U.money(i.amount_due - i.paid_amount) %><%= i.retention_amount > i.retention_paid ? ', zádržné ' + U.money(i.retention_amount - i.retention_paid) : '' %>)</option><% } %></select></div>
      <div class="field"><select name="kind"><option value="payment">úhrada faktúry</option><option value="retention">vyplatenie zádržného</option></select></div>
      <div class="field" style="flex:0"><button class="btn">Spárovať</button></div>
    </form><% } %>
    <% } else { %><h2>Odchádzajúca platba</h2><p class="muted">Odchádzajúce platby sa nepárujú s vystavenými faktúrami. Môžete ich zaevidovať ako náklad.</p><% } %>
  </div>
</div>
<%- include('../partials/footer') %>
